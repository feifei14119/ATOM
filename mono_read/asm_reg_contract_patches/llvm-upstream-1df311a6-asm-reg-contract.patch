+#define DEBUG_TYPE "amdgpu-contract"
+
+static constexpr StringLiteral ContractAttr = "amdgpu-contract";
+static constexpr StringLiteral ClobberAttr = "amdgpu-contract-clobber";
+static constexpr StringLiteral RegAttr = "amdgpu-reg";
+static constexpr StringLiteral SiteMarker = ";@amdgpu-contract-site ";
+static constexpr StringLiteral AsmHeader = ";@amdgpu-contract ";
+
+static cl::opt<std::string> SpillPolicy(
+    "amdgpu-spill-policy",
+    cl::desc("Default for the amdgpu-spill-policy function attribute: 'allow' "
+             "or 'error' (any VGPR spill or stack object is an error)"),
+    cl::init("allow"));
+
+static cl::opt<unsigned> SGPRLaneSpillMax(
+    "amdgpu-sgpr-lane-spill-max",
+    cl::desc("Default for amdgpu-sgpr-lane-spill-max: SGPRs that may be "
+             "spilled to VGPR lanes under amdgpu-spill-policy=error"),
+    cl::init(0));
+
+static cl::opt<std::string> ContractReportFile(
+    "amdgpu-contract-report",
+    cl::desc("Append a JSON line per function describing contract call sites "
+             "and spills to this file"),
+    cl::init(""));
