+attributes #2 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="s[0:1]" "amdgpu-asm-result-reg"="v[8:9]" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="10" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
