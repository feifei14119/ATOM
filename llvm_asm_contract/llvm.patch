index 000000000000..32e35afd5982
--- /dev/null
+++ b/llvm/lib/Target/AMDGPU/AMDGPUAsmCallContract.cpp
@@ -0,0 +1,239 @@
+//===- AMDGPUAsmCallContract.cpp - External assembly calls
+//-----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "AMDGPUAsmCallContract.h"
+#include "GCNSubtarget.h"
+#include "SIRegisterInfo.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/IR/Function.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/Support/MathExtras.h"
+
+using namespace llvm;
+
+MCRegister AMDGPUAsmCallContract::RegisterSpan::getDWord(unsigned Part) const {
+  assert(Part < Count);
+  return Kind == 's' ? AMDGPU::SGPR_32RegClass.getRegister(First + Part)
+                     : AMDGPU::VGPR_32RegClass.getRegister(First + Part);
+}
+
+bool llvm::hasAMDGPUAsmCallContract(const Function &F) {
+  return F.hasFnAttribute("amdgpu-asm-contract");
+}
+
+namespace {
+Error contractError(const Function &F, const Twine &Message) {
+  return createStringError(
+      inconvertibleErrorCode(),
+      ("AMDGPU ASM contract for '" + F.getName() + "': " + Message).str());
+}
+
+Expected<unsigned> readCount(const Function &F, StringRef Name) {
+  Attribute A = F.getFnAttribute(Name);
+  unsigned Count;
+  if (!A.isStringAttribute() || A.getValueAsString().empty() ||
+      A.getValueAsString().getAsInteger(10, Count))
+    return contractError(F, "expected unsigned integer attribute " + Name);
+  return Count;
+}
+
+Expected<AMDGPUAsmCallContract::RegisterSpan>
+parseSpan(const Function &F, StringRef Text, const GCNSubtarget &ST) {
+  Text = Text.trim();
+  if (Text.size() < 2 || (Text[0] != 's' && Text[0] != 'v'))
+    return contractError(F, "invalid numbered register '" + Text + "'");
+  char Kind = Text.front();
+  StringRef Index = Text.drop_front();
+  unsigned First, Last;
+  if (Index.starts_with("[") && Index.ends_with("]")) {
+    auto Pair = Index.drop_front().drop_back().split(':');
+    if (Pair.second.empty() || Pair.first.getAsInteger(10, First) ||
+        Pair.second.getAsInteger(10, Last) || Last < First)
+      return contractError(F, "invalid register range '" + Text + "'");
+  } else {
+    if (Index.getAsInteger(10, First))
+      return contractError(F, "invalid register '" + Text + "'");
+    Last = First;
+  }
+  unsigned Limit = Kind == 's' ? ST.getAddressableNumSGPRs()
+                               : ST.getAddressableNumArchVGPRs();
+  if (Last >= Limit)
+    return contractError(F, "register range exceeds target limits: '" + Text +
+                                "'");
+  // Version 1 retains the normal return-PC and stack bookkeeping registers.
+  // They are not an implicit argument block and the callee may not use them as
+  // ordinary parameters, results or destructive temporaries.
+  if (Kind == 's' && First <= 39 && Last >= 30)
+    return contractError(F, "s[30:39] are reserved for call state");
+  return AMDGPUAsmCallContract::RegisterSpan{Kind, First, Last - First + 1};
+}
+
+unsigned typeDWords(Type *Ty, const DataLayout &DL) {
+  if (Ty->isIntegerTy(32))
+    return 1;
+  if (Ty->isIntegerTy(64))
+    return 2;
+  if (Ty->isPointerTy() && DL.getTypeSizeInBits(Ty) == 64)
+    return 2;
+  return 0;
+}
+} // namespace
+
+Expected<AMDGPUAsmCallContract>
+llvm::parseAMDGPUAsmCallContract(const Function &F, const GCNSubtarget &ST) {
+  if (F.getFnAttribute("amdgpu-asm-contract").getValueAsString() != "1")
+    return contractError(F, "unsupported contract version (expected 1)");
+  if (!ST.hasGFX1250Insts() || !ST.isWave32() ||
+      ST.getTargetTriple().getOS() != Triple::AMDHSA)
+    return contractError(F, "version 1 requires gfx1250 wave32 AMDHSA");
+  if (!F.isDeclaration() || F.isIntrinsic())
+    return contractError(F,
+                         "version 1 requires an external assembly declaration");
+  if (F.hasAddressTaken())
+    return contractError(
+        F, "version 1 forbids address escapes, aliases, and signature casts");
+  if (F.getCallingConv() != CallingConv::C || F.isVarArg())
+    return contractError(
+        F, "version 1 requires a non-variadic C call declaration");
+  if (!F.isConvergent() || !F.doesNotThrow() || !F.doesNotRecurse())
+    return contractError(F,
+                         "declaration must be convergent nounwind norecurse");
+
+  AMDGPUAsmCallContract C;
+  auto V = readCount(F, "amdgpu-asm-vgpr-count");
+  if (!V)
+    return V.takeError();
+  C.NumVGPRs = *V;
+  auto S = readCount(F, "amdgpu-asm-sgpr-count");
+  if (!S)
+    return S.takeError();
+  C.NumSGPRs = *S;
+  auto P = readCount(F, "amdgpu-asm-private-bytes");
+  if (!P)
+    return P.takeError();
+  C.PrivateBytes = *P;
+  if (C.PrivateBytes != 0)
+    return contractError(F, "version 1 forbids private memory");
+  if (C.NumVGPRs > ST.getAddressableNumArchVGPRs() || C.NumSGPRs < 32 ||
+      C.NumSGPRs > ST.getAddressableNumSGPRs())
+    return contractError(F, "invalid register resource extent (SGPR extent "
+                            "must include return PC s[30:31])");
+
+  auto CheckExtent =
+      [&](const AMDGPUAsmCallContract::RegisterSpan &R) -> Error {
+    if (R.First + R.Count > (R.Kind == 's' ? C.NumSGPRs : C.NumVGPRs))
+      return contractError(F, "register use exceeds declared resource extent");
+    return Error::success();
+  };
+  auto CheckType = [&](const AMDGPUAsmCallContract::RegisterSpan &R,
+                       Type *Ty) -> Error {
+    if (!typeDWords(Ty, F.getDataLayout()) ||
+        R.Count != typeDWords(Ty, F.getDataLayout()))
+      return contractError(
+          F, "register width must match a 32/64-bit scalar argument or result");
+    if (R.Count == 2 && R.First % 2)
+      return contractError(
+          F, "64-bit register tuples must start at an even register");
+    return CheckExtent(R);
+  };
+
+  Attribute ArgAttr = F.getFnAttribute("amdgpu-asm-arg-regs");
+  if (!ArgAttr.isStringAttribute())
+    return contractError(F, "missing amdgpu-asm-arg-regs");
+  SmallVector<StringRef, 8> Names;
+  if (!ArgAttr.getValueAsString().empty())
+    ArgAttr.getValueAsString().split(Names, ',');
+  if (Names.size() != F.arg_size())
+    return contractError(F, "argument register count does not match signature");
+  BitVector Used(ST.getRegisterInfo()->getNumRegs());
+  for (auto [Arg, Name] : zip(F.args(), Names)) {
+    if (Arg.hasByValAttr() || Arg.hasStructRetAttr() || Arg.hasInAllocaAttr() ||
+        Arg.hasAttribute(Attribute::ByRef) ||
+        Arg.hasAttribute(Attribute::Preallocated))
+      return contractError(
+          F, "memory/aggregate argument attributes are unsupported");
+    auto R = parseSpan(F, Name, ST);
+    if (!R)
+      return R.takeError();
+    if (Error E = CheckType(*R, Arg.getType()))
+      return std::move(E);
+    for (unsigned I = 0; I < R->Count; ++I) {
+      unsigned Reg = R->getDWord(I);
+      if (Used.test(Reg))
+        return contractError(F, "overlapping argument register bindings");
+      Used.set(Reg);
+    }
+    C.ArgRegs.push_back(*R);
+  }
+
+  Attribute ResultAttr = F.getFnAttribute("amdgpu-asm-result-reg");
+  StringRef ResultName = ResultAttr.isStringAttribute()
+                             ? ResultAttr.getValueAsString()
+                             : StringRef();
+  if (F.getReturnType()->isVoidTy()) {
+    if (!ResultName.empty())
+      return contractError(F, "void function cannot bind a result register");
+  } else {
+    auto R = parseSpan(F, ResultName, ST);
+    if (!R)
+      return R.takeError();
+    if (Error E = CheckType(*R, F.getReturnType()))
+      return std::move(E);
+    C.ResultReg = *R;
+  }
+
+  Attribute ClobberAttr = F.getFnAttribute("amdgpu-asm-clobbers");
+  if (!ClobberAttr.isStringAttribute())
+    return contractError(F, "missing complete amdgpu-asm-clobbers declaration");
+  Names.clear();
+  if (!ClobberAttr.getValueAsString().empty())
+    ClobberAttr.getValueAsString().split(Names, ',');
+  for (StringRef Name : Names) {
+    Name = Name.trim();
+    if (Name == "scc") {
+      C.ClobberedRegs.push_back(AMDGPU::SCC);
+      // The encoded read-only source view is not a TableGen register alias.
+      C.ClobberedRegs.push_back(AMDGPU::SRC_SCC);
+      continue;
+    }
+    if (Name == "vcc") {
+      C.ClobberedRegs.push_back(AMDGPU::VCC);
+      C.ClobberedRegs.push_back(AMDGPU::SRC_VCCZ);
+      C.ClobbersVCC = true;
+      continue;
+    }
+    auto R = parseSpan(F, Name, ST);
+    if (!R)
+      return R.takeError();
+    if (Error E = CheckExtent(*R))
+      return std::move(E);
+    for (unsigned I = 0; I < R->Count; ++I)
+      C.ClobberedRegs.push_back(R->getDWord(I));
+  }
+  // A result is a definition, regardless of whether the supplier redundantly
+  // included it in the net clobber list.
+  if (C.ResultReg)
+    for (unsigned I = 0; I < C.ResultReg->Count; ++I)
+      C.ClobberedRegs.push_back(C.ResultReg->getDWord(I));
+  return C;
+}
+
+const uint32_t *
+AMDGPUAsmCallContract::createCallPreservedMask(MachineFunction &MF) const {
+  const SIRegisterInfo &TRI =
+      *MF.getSubtarget<GCNSubtarget>().getRegisterInfo();
+  uint32_t *Mask = MF.allocateRegMask();
+  std::fill_n(Mask, MachineOperand::getRegMaskSize(TRI.getNumRegs()), ~0u);
+  Mask[0] &= ~1u;
+  for (MCRegister Reg : ClobberedRegs)
+    for (MCRegAliasIterator Alias(Reg, &TRI, true); Alias.isValid(); ++Alias)
+      Mask[*Alias / 32] &= ~(uint32_t(1) << (*Alias % 32));
+  return Mask;
+}
