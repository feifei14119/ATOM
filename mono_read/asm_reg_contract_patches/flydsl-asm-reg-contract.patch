+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 FlyDSL Project Contributors
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from flydsl.compiler.asm_contract import (
+    ContractError,
+    Manifest,
+    _generate_ll,
+    check_footprint,
+    format_regs,
+    pack,
+    parse_regs,
+    spill_hints,
+)
+
+pytestmark = [pytest.mark.l1b_target_dialect, pytest.mark.rocm_lower]
+
+
+def _manifest(**overrides):
+    data = {
+        "name": "frag",
+        "source": "frag.s",
+        "params": [
+            {"name": "args", "reg": "s[0:1]", "type": "uint64"},
+            {"name": "lane", "reg": "v0", "type": "uint32"},
+            {"name": "wave", "reg": "s24", "type": "uint32"},
+        ],
+        "preserves": ["exec", "mode"],
+    }
+    data.update(overrides)
+    return Manifest.from_dict(data, base=Path("/tmp"))
+
+
+def _footprint(sgpr="s[2:5]", vgpr="v[4:7]", special=("scc",), **extra):
+    fp = {
+        "writes": {"sgpr": sgpr, "vgpr": vgpr, "special": list(special), "num_sgpr": 0, "num_vgpr": 0},
+        "reads": {"sgpr": "s[0:1]", "vgpr": "v0", "special": [], "num_sgpr": 0, "num_vgpr": 0},
+        "forbidden": [],
+        "has_relocations": False,
+        "vgpr_msb_exit": 0,
+        "warnings": [],
+        "instructions": 4,
+    }
+    fp.update(extra)
+    return fp
+
+
+def test_parse_and_format_register_sets():
+    regs = parse_regs(["s[2:4]", "s5", "v[300:301]", "SCC", " memory "])
+    assert ("s", 2) in regs and ("s", 5) in regs and ("v", 301) in regs
+    assert {"scc", "memory"} <= regs
+    assert format_regs(regs) == "s[2:5],v[300:301],memory,scc"
+    assert parse_regs("v1, v3") == {("v", 1), ("v", 3)}
+    with pytest.raises(ContractError, match="bad register range"):
+        parse_regs(["v[5:4]"])
+
+
+@pytest.mark.parametrize(
+    "param, message",
+    [
+        ({"name": "a", "reg": "s[1:2]", "type": "uint64"}, "even SGPR"),
+        ({"name": "a", "reg": "v[0:2]", "type": "uint64"}, "one or two"),
+        ({"name": "a", "reg": "v0", "type": "uint64"}, "does not fit"),
+        ({"name": "a", "reg": "v0", "type": "float32"}, "type must be one of"),
+    ],
+)
+def test_manifest_rejects_bad_params(param, message):
+    with pytest.raises(ContractError, match=message):
+        _manifest(params=[param])
+
+
+def test_manifest_rejects_unknown_keys():
+    with pytest.raises(ContractError, match="unknown manifest keys"):
+        _manifest(clobber=["v1"])
+
+
+def test_clobber_defaults_to_footprint_minus_preserved():
+    clobber, warnings = check_footprint(_manifest(), _footprint(special=("scc", "exec", "mode")))
+    assert clobber == "s[2:5],v[4:7],scc"
+    assert warnings == []
+
+
+@pytest.mark.parametrize(
+    "overrides, footprint, message",
+    [
+        ({"clobbers": ["s[2:4]", "v[4:7]", "scc"]}, {}, "writes s5, which is not in clobbers"),
+        ({}, {"vgpr": "v0,v[4:7]"}, r"writes input register\(s\) v0"),
+        ({"preserves": []}, {"special": ("scc", "exec")}, "changes exec"),
+        ({}, {"forbidden": [{"offset": 8, "opcode": "S_ENDPGM_gfx12"}]}, "S_ENDPGM_gfx12@8"),
+        ({}, {"vgpr_msb_exit": 0x40}, "VGPR MSBs 0x40"),
+        ({}, {"has_relocations": True}, "relocations"),
+    ],
+)
+def test_check_footprint_errors(overrides, footprint, message):
+    extra = {k: footprint.pop(k) for k in list(footprint) if k in ("forbidden", "vgpr_msb_exit", "has_relocations")}
+    with pytest.raises(ContractError, match=message):
+        check_footprint(_manifest(**overrides), _footprint(**footprint, **extra))
+
+
+def test_overdeclared_clobbers_warn():
+    clobber, warnings = check_footprint(_manifest(clobbers=["s[2:5]", "v[4:15]", "scc"]), _footprint())
+    assert clobber == "s[2:5],v[4:15],scc"
+    assert any("v[8:15]" in w for w in warnings)
+
+
+def test_generated_contract_function():
+    ll = _generate_ll(_manifest(align=64), [0xBF800000, 0xBF800001], "s[2:5],v[4:7],scc")
+    assert (
+        'define void @frag(i64 "amdgpu-reg"="s[0:1]" %args, i32 "amdgpu-reg"="v0" %lane, '
+        'i32 "amdgpu-reg"="s24" %wave) #0' in ll
+    )
+    # Uniform SGPR inputs are made legal for an SGPR; VGPR inputs pass through.
+    assert "@llvm.amdgcn.readfirstlane.i64(i64 %args)" in ll
+    assert "@llvm.amdgcn.readfirstlane.i32(i32 %wave)" in ll
+    assert "readfirstlane.i32(i32 %lane)" not in ll
+    assert "s_branch 1f\\0A.p2align 6\\0A1:\\0A.long 0xbf800000\\0A.long 0xbf800001\\0A" in ll
+    assert '"{s[0:1]},{v0},{s24},~{s[2:5]},~{v[4:7]},~{scc},~{memory}"' in ll
+    assert '"amdgpu-contract"="frag" "amdgpu-contract-clobber"="s[2:5],v[4:7],scc"' in ll
+    assert "noinline convergent" in ll
+
+
+def test_spill_hints():
+    assert spill_hints() == {"amdgpu-spill-policy": "error", "amdgpu-sgpr-lane-spill-max": 0}
+    assert spill_hints("allow", sgpr_lane_spill_max=4, report="r.jsonl")["amdgpu-contract-report"] == "r.jsonl"
+    with pytest.raises(ValueError):
