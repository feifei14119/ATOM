diff --git a/llvm/test/CodeGen/AMDGPU/inline-asm-clobber-vgpr-hi-gfx1250.ll b/llvm/test/CodeGen/AMDGPU/inline-asm-clobber-vgpr-hi-gfx1250.ll
new file mode 100644
index 000000000..ca8762d05
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/inline-asm-clobber-vgpr-hi-gfx1250.ll
@@ -0,0 +1,23 @@
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 < %s | FileCheck %s
+
+; gfx1250 has 1024 VGPRs: clobbers of v256 and above must be honoured, both for
+; register allocation across the asm and for the kernel's VGPR count.
+
+; The only value live across the asm cannot use v[0:287].
+; CHECK-LABEL: .name: live_across_hi_clobber
+; CHECK: .vgpr_count: 290
+define amdgpu_kernel void @live_across_hi_clobber(ptr addrspace(1) %p) #0 {
+  %v = load i32, ptr addrspace(1) %p
+  call void asm sideeffect "; clobber v[0:287]", "~{v[0:31]},~{v[32:63]},~{v[64:95]},~{v[96:127]},~{v[128:159]},~{v[160:191]},~{v[192:223]},~{v[224:255]},~{v[256:287]}"()
+  store i32 %v, ptr addrspace(1) %p
+  ret void
+}
+
+; CHECK-LABEL: .name: clobber_v300
+; CHECK: .vgpr_count: 301
+define amdgpu_kernel void @clobber_v300() #0 {
+  call void asm sideeffect "; clobber v300", "~{v300}"()
+  ret void
+}
+
+attributes #0 = { "amdgpu-flat-work-group-size"="1,256" "amdgpu-waves-per-eu"="1,1" }
