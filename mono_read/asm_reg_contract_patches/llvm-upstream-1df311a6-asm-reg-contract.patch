index 000000000..47c09a02e
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/amdgpu-contract-call.ll
@@ -0,0 +1,54 @@
+; RUN: rm -f %t.json
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -amdgpu-spill-policy=error -amdgpu-contract-report=%t.json < %s | FileCheck %s
+; RUN: FileCheck --check-prefix=REPORT --input-file=%t.json %s
+
+; A register-contract function is expanded in place: no call, no stack, its
+; parameters arrive in the declared registers, and caller values live across
+; the call stay outside the declared footprint.
+
+; CHECK-LABEL: k:
+; CHECK-NOT: s_swap
+; CHECK: v_readfirstlane_b32 s24,
+; CHECK: v_add_nc_u64_e32 v[0:1],
+; CHECK: ;@amdgpu-contract frag site=test.py:42 clobber=s[2:23],s[25:29],v[6:511],scc
+; CHECK-NEXT: .long 0xbf800000
+; CHECK-NOT: s_swap
+; CHECK: s_endpgm
+; CHECK-NOT: {{^}}frag:
+; CHECK: .private_segment_fixed_size: 0
+; CHECK-NOT: {{^}}frag:
+
+; REPORT: "callsites":[{"clobber":"s[2:23],s[25:29],v[6:511],scc","contract":"frag",
+; REPORT-SAME: "live_vgpr":2,"live_vgpr_regs":"v2,v4","site":"test.py:42"}]
+; REPORT-SAME: "function":"k","max_vgpr":512,"policy":"error"
+; REPORT-SAME: "stack_objects":0,"status":"ok","vgpr_spills":[]
+
+target triple = "amdgcn-amd-amdhsa"
+declare i32 @llvm.amdgcn.workitem.id.x()
+declare i32 @llvm.amdgcn.workgroup.id.x()
+declare i64 @llvm.amdgcn.readfirstlane.i64(i64)
+declare i32 @llvm.amdgcn.readfirstlane.i32(i32)
+
+define void @frag(i64 "amdgpu-reg"="s[0:1]" %wg, i64 "amdgpu-reg"="v[0:1]" %buf, i32 "amdgpu-reg"="s24" %wave) #1 {
+  %wgu = call i64 @llvm.amdgcn.readfirstlane.i64(i64 %wg)
+  %wu = call i32 @llvm.amdgcn.readfirstlane.i32(i32 %wave)
+  call void asm sideeffect ".long 0xbf800000", "{s[0:1]},{v[0:1]},{s24},~{s[2:23]},~{s[25:29]},~{v[6:511]},~{scc},~{memory}"(i64 %wgu, i64 %buf, i32 %wu)
+  ret void
+}
+
+define amdgpu_kernel void @k(ptr addrspace(1) %p) #0 {
+  %t = call i32 @llvm.amdgcn.workitem.id.x()
+  %g = call i32 @llvm.amdgcn.workgroup.id.x()
+  %a = getelementptr i32, ptr addrspace(1) %p, i32 %t
+  %v = load i32, ptr addrspace(1) %a
+  %gi = zext i32 %g to i64
+  %pi = ptrtoint ptr addrspace(1) %a to i64
+  %w = lshr i32 %t, 5
+  call void asm sideeffect ";@amdgpu-contract-site test.py:42", ""()
+  call void @frag(i64 %gi, i64 %pi, i32 %w)
+  %r = add i32 %v, %g
+  store i32 %r, ptr addrspace(1) %a
+  ret void
+}
+attributes #0 = { "amdgpu-flat-work-group-size"="256,256" }
+attributes #1 = { noinline convergent "amdgpu-contract"="frag" "amdgpu-contract-clobber"="s[2:23],s[25:29],v[6:511],scc" }
