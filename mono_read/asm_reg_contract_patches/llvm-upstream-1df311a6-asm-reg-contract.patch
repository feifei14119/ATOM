+//===- amdgpu-asm-footprint.cpp - Registers written by AMDGPU code --------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Decodes the code of an AMDGPU object file (or one symbol in it) and prints,
+// as JSON, every register the code writes and reads, the VGPR MSB state at the
+// end, and instructions that must not appear in a register-contract function.
+//
+// Writes are taken from the instruction descriptions (explicit and implicit
+// defs), and VGPRs above v255 are resolved by following s_set_vgpr_msb in
+// program order.
+//
+//===----------------------------------------------------------------------===//
+
+#include "MCTargetDesc/AMDGPUInstPrinter.h"
+#include "MCTargetDesc/AMDGPUMCTargetDesc.h"
+#include "SIDefines.h"
+#include "Utils/AMDGPUBaseInfo.h"
+#include "llvm/MC/MCAsmInfo.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCDisassembler/MCDisassembler.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCInstrAnalysis.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/MCTargetOptions.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Object/ELFObjectFile.h"
+#include "llvm/Object/ObjectFile.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/InitLLVM.h"
+#include "llvm/Support/JSON.h"
+#include "llvm/Support/TargetSelect.h"
+#include "llvm/Support/WithColor.h"
+#include "llvm/Support/raw_ostream.h"
+#include <set>
+
+using namespace llvm;
+using namespace llvm::object;
+
+static cl::opt<std::string> InputFile(cl::Positional, cl::desc("<object>"),
+                                      cl::Required);
+static cl::opt<std::string> MCPU("mcpu", cl::desc("Target CPU"),
+                                 cl::init("gfx1250"));
+static cl::opt<std::string> Symbol("symbol",
+                                   cl::desc("Only analyze this symbol "
+                                            "(default: the whole .text)"),
+                                   cl::init(""));
+static cl::opt<std::string>
+    BytesOut("bytes-out", cl::desc("Write the analyzed code bytes to this file"),
+             cl::init(""));
+static cl::opt<unsigned> InitialMSBs(
+    "initial-vgpr-msb",
+    cl::desc("VGPR MSB state (s_set_vgpr_msb encoding) at the first "
+             "instruction"),
+    cl::init(0));
+
+namespace {
+
+[[noreturn]] void fail(const Twine &Msg) {
+  WithColor::error(errs(), "amdgpu-asm-footprint") << Msg << '\n';
+  exit(1);
+}
+
+/// Same mapping the instruction printer uses to show "v0 /*v256*/".
+MCRegister applyMSBs(MCRegister Reg, unsigned OpNo, const MCInstrDesc &Desc,
+                     const MCRegisterInfo &MRI, unsigned MSBs) {
+  if (!MSBs)
+    return Reg;
+  if (!(MRI.getEncodingValue(Reg) & AMDGPU::HWEncoding::IS_VGPR))
+    return Reg;
+  auto Ops = AMDGPU::getVGPRLoweringOperandTables(Desc);
+  if (!Ops.first)
+    return Reg;
+  unsigned Opc = Desc.getOpcode();
+  unsigned I;
+  for (I = 0; I < 4; ++I) {
+    if (Ops.first[I] != AMDGPU::OpName::NUM_OPERAND_NAMES &&
+        (unsigned)AMDGPU::getNamedOperandIdx(Opc, Ops.first[I]) == OpNo)
+      break;
+    if (Ops.second && Ops.second[I] != AMDGPU::OpName::NUM_OPERAND_NAMES &&
+        (unsigned)AMDGPU::getNamedOperandIdx(Opc, Ops.second[I]) == OpNo)
+      break;
+  }
+  if (I == 4)
+    return Reg;
+  unsigned OpMSBs = (MSBs >> (I * 2)) & 3;
+  if (!OpMSBs)
+    return Reg;
+  if (MCRegister New = AMDGPU::getVGPRWithMSBs(Reg, OpMSBs, MRI))
+    return New;
+  return Reg;
+}
+
+struct RegSets {
+  std::set<unsigned> VGPR, SGPR;
+  std::set<std::string> Special;
+};
+
+class Analyzer {
+  const MCRegisterInfo &MRI;
+  const MCRegisterClass &VGPR32, &SGPR32;
+
+public:
+  explicit Analyzer(const MCRegisterInfo &MRI)
+      : MRI(MRI), VGPR32(MRI.getRegClass(AMDGPU::VGPR_32RegClassID)),
+        SGPR32(MRI.getRegClass(AMDGPU::SGPR_32RegClassID)) {}
+
+  void add(MCRegister Reg, RegSets &S) const {
+    bool Any = false;
+    for (MCRegister Sub : MRI.subregs_inclusive(Reg)) {
+      if (VGPR32.contains(Sub)) {
+        S.VGPR.insert(MRI.getEncodingValue(Sub) &
+                      AMDGPU::HWEncoding::REG_IDX_MASK);
+        Any = true;
+      } else if (SGPR32.contains(Sub)) {
+        S.SGPR.insert(MRI.getEncodingValue(Sub) &
+                      AMDGPU::HWEncoding::REG_IDX_MASK);
+        Any = true;
+      }
+    }
+    if (Any)
+      return;
+    switch (Reg.id()) {
+    case AMDGPU::VCC:
+    case AMDGPU::VCC_LO:
+    case AMDGPU::VCC_HI:
+      S.Special.insert("vcc");
+      return;
+    case AMDGPU::EXEC:
+    case AMDGPU::EXEC_LO:
+    case AMDGPU::EXEC_HI:
+      S.Special.insert("exec");
+      return;
+    case AMDGPU::SCC:
+      S.Special.insert("scc");
+      return;
+    case AMDGPU::M0:
+      S.Special.insert("m0");
+      return;
+    case AMDGPU::MODE:
+      S.Special.insert("mode");
+      return;
+    default:
+      S.Special.insert(StringRef(AMDGPUInstPrinter::getRegisterName(Reg)).lower());
+    }
+  }
+};
+
+std::string formatRange(char Kind, const std::set<unsigned> &Idx) {
+  std::string S;
+  raw_string_ostream OS(S);
+  for (auto I = Idx.begin(); I != Idx.end();) {
+    unsigned First = *I, Last = *I;
+    for (++I; I != Idx.end() && *I == Last + 1; ++I)
+      Last = *I;
+    if (!S.empty())
+      OS << ',';
+    if (First == Last)
+      OS << Kind << First;
+    else
+      OS << Kind << '[' << First << ':' << Last << ']';
+  }
+  return S;
+}
+
+json::Object toJSON(const RegSets &S) {
+  json::Array Special;
+  for (const std::string &N : S.Special)
+    Special.push_back(N);
+  return json::Object{{"vgpr", formatRange('v', S.VGPR)},
+                      {"sgpr", formatRange('s', S.SGPR)},
+                      {"special", std::move(Special)},
+                      {"num_vgpr", (int64_t)S.VGPR.size()},
+                      {"num_sgpr", (int64_t)S.SGPR.size()}};
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  InitLLVM X(argc, argv);
+  LLVMInitializeAMDGPUTargetInfo();
+  LLVMInitializeAMDGPUTargetMC();
+  LLVMInitializeAMDGPUDisassembler();
+  cl::ParseCommandLineOptions(argc, argv,
+                              "registers written by AMDGPU machine code\n");
+
+  Expected<OwningBinary<ObjectFile>> ObjOrErr =
+      ObjectFile::createObjectFile(InputFile);
+  if (!ObjOrErr)
+    fail(toString(ObjOrErr.takeError()));
+  ObjectFile &Obj = *ObjOrErr->getBinary();
+
+  Triple TT("amdgcn-amd-amdhsa");
+  std::string Err;
+  const Target *T = TargetRegistry::lookupTarget(TT, Err);
+  if (!T)
+    fail(Err);
+  std::unique_ptr<MCRegisterInfo> MRI(T->createMCRegInfo(TT));
+  MCTargetOptions MCOpts;
+  std::unique_ptr<MCAsmInfo> MAI(T->createMCAsmInfo(*MRI, TT, MCOpts));
+  std::unique_ptr<MCSubtargetInfo> STI(
+      T->createMCSubtargetInfo(TT, MCPU, ""));
+  std::unique_ptr<MCInstrInfo> MII(T->createMCInstrInfo());
+  if (!MRI || !MAI || !STI || !MII)
+    fail("cannot create the AMDGPU MC layer for " + MCPU);
+  MCContext Ctx(TT, *MAI, *MRI, *STI);
+  std::unique_ptr<MCDisassembler> DisAsm(T->createMCDisassembler(*STI, Ctx));
+  if (!DisAsm)
+    fail("no disassembler");
+
+  // Locate the bytes to analyze.
+  ArrayRef<uint8_t> Bytes;
+  uint64_t Base = 0;
+  bool HasRelocs = false;
+  for (const SectionRef &Sec : Obj.sections()) {
+    Expected<StringRef> Name = Sec.getName();
+    if (!Name || *Name != ".text")
+      continue;
+    Expected<StringRef> Contents = Sec.getContents();
+    if (!Contents)
+      fail(toString(Contents.takeError()));
+    Bytes = arrayRefFromStringRef(*Contents);
+    Base = Sec.getAddress();
+    HasRelocs = !Sec.relocations().empty();
+    if (!Symbol.empty()) {
+      bool Found = false;
+      for (const SymbolRef &Sym : Obj.symbols()) {
+        Expected<StringRef> SName = Sym.getName();
+        if (!SName || *SName != Symbol)
+          continue;
+        uint64_t Addr = cantFail(Sym.getAddress());
+        uint64_t Size = ELFSymbolRef(Sym).getSize();
+        if (!Size || Addr < Base || Addr + Size > Base + Bytes.size())
+          fail("symbol '" + Symbol + "' has no size or is outside .text");
+        Bytes = Bytes.slice(Addr - Base, Size);
+        Base = Addr;
+        Found = true;
+        break;
+      }
+      if (!Found)
+        fail("symbol '" + Symbol + "' not found");
+    }
+    break;
+  }
+  if (Bytes.empty())
+    fail("no .text code in " + InputFile);
+  if (!BytesOut.empty()) {
+    std::error_code EC;
+    raw_fd_ostream OS(BytesOut, EC);
+    if (EC)
+      fail("cannot write " + BytesOut + ": " + EC.message());
+    OS.write(reinterpret_cast<const char *>(Bytes.data()), Bytes.size());
+  }
+
+  Analyzer A(*MRI);
+  RegSets Writes, Reads;
+  json::Array Forbidden;
+  unsigned MSBs = InitialMSBs;
+  unsigned NumInsts = 0, Branches = 0;
+  bool UsesHighVGPRs = InitialMSBs != 0;
+
+  for (uint64_t Off = 0; Off < Bytes.size();) {
+    MCInst Inst;
+    uint64_t Size = 0;
+    if (DisAsm->getInstruction(Inst, Size, Bytes.slice(Off), Base + Off,
+                               nulls()) != MCDisassembler::Success ||
+        !Size)
+      fail("cannot decode instruction at offset " + Twine(Off));
+    ++NumInsts;
+    const MCInstrDesc &Desc = MII->get(Inst.getOpcode());
+    StringRef OpName = MII->getName(Inst.getOpcode());
+
+    for (unsigned I = 0, E = Inst.getNumOperands(); I < E; ++I) {
+      const MCOperand &Op = Inst.getOperand(I);
+      if (!Op.isReg() || !Op.getReg())
+        continue;
+      MCRegister R = applyMSBs(Op.getReg(), I, Desc, *MRI, MSBs);
+      A.add(R, I < Desc.getNumDefs() ? Writes : Reads);
+    }
+    // The VGPR MSBs live in MODE but are checked through vgpr_msb_exit.
+    const bool IsSetMSB = Inst.getOpcode() == AMDGPU::S_SET_VGPR_MSB_gfx12;
+    for (MCPhysReg R : Desc.implicit_defs())
+      if (!(IsSetMSB && R == AMDGPU::MODE))
+        A.add(R, Writes);
+    for (MCPhysReg R : Desc.implicit_uses())
+      A.add(R, Reads);
+
+    if (OpName.starts_with("S_SETREG") || OpName.starts_with("S_ROUND_MODE") ||
+        OpName.starts_with("S_DENORM_MODE"))
+      Writes.Special.insert("mode");
+    if (Desc.isBranch())
+      ++Branches;
+    for (StringRef Bad : {"S_ENDPGM", "S_SETPC", "S_SWAPPC", "S_SET_PC",
+                          "S_SWAP_PC", "S_CALL", "S_RFE"})
+      if (OpName.starts_with(Bad))
+        Forbidden.push_back(json::Object{{"offset", (int64_t)Off},
+                                         {"opcode", OpName}});
+
+    if (Inst.getOpcode() == AMDGPU::S_SET_VGPR_MSB_gfx12) {
+      MSBs = Inst.getOperand(0).getImm() & 0xff;
+    } else if (Inst.getOpcode() == AMDGPU::S_SETREG_IMM32_B32_gfx12 &&
+               STI->hasFeature(AMDGPU::Feature1024AddressableVGPRs)) {
+      if (auto M = AMDGPU::convertSetRegImmToVgprMSBs(
+              Inst, STI->hasFeature(AMDGPU::FeatureSetregVGPRMSBFixup)))
+        MSBs = *M;
+    }
+    if (MSBs)
+      UsesHighVGPRs = true;
+    Off += Size;
+  }
+
+  json::Array Warnings;
+  if (UsesHighVGPRs && Branches)
+    Warnings.push_back("VGPR MSBs are tracked in program order; check that "
+                       "every branch target is reached with the same MSBs");
+  if (HasRelocs)
+    Warnings.push_back(".text has relocations; the code is not "
+                       "position-independent as encoded");
+
+  json::Object Out{{"cpu", MCPU},
+                   {"bytes", (int64_t)Bytes.size()},
+                   {"instructions", (int64_t)NumInsts},
+                   {"writes", toJSON(Writes)},
+                   {"reads", toJSON(Reads)},
+                   {"vgpr_msb_exit", (int64_t)MSBs},
+                   {"has_relocations", HasRelocs},
+                   {"forbidden", std::move(Forbidden)},
+                   {"warnings", std::move(Warnings)}};
+  outs() << formatv("{0:2}", json::Value(std::move(Out))) << '\n';
+  return 0;
+}
