+namespace {
+
+/// A set of register names such as "v12", "s3", "scc".
+using RegNameSet = std::set<std::string>;
+
+/// Parse "s[2:23],v4,scc" (with or without surrounding braces per element).
+bool parseRegList(StringRef List, RegNameSet &Out, std::string &Err) {
+  SmallVector<StringRef, 16> Parts;
+  List.split(Parts, ',', -1, /*KeepEmpty=*/false);
+  for (StringRef P : Parts) {
+    P = P.trim();
+    if (P.consume_front("{") && !P.consume_back("}")) {
+      Err = ("malformed register '" + P + "'").str();
+      return false;
+    }
+    auto [Kind, Idx, NumRegs] = AMDGPU::parseAsmPhysRegName(P);
+    if (Kind == 'v' || Kind == 's') {
+      for (unsigned I = 0; I < NumRegs; ++I)
+        Out.insert((Twine(Kind) + Twine(Idx + I)).str());
+      continue;
+    }
+    if (P.empty() || !all_of(P, [](char C) { return isAlnum(C) || C == '_'; })) {
+      Err = ("malformed register '" + P + "'").str();
+      return false;
+    }
+    Out.insert(P.lower());
+  }
+  return true;
+}
+
+/// Compress a sorted list of indices into "v[0:3],v7".
+std::string formatRegs(char Kind, ArrayRef<unsigned> Idx) {
+  std::string S;
+  raw_string_ostream OS(S);
+  for (size_t I = 0; I < Idx.size();) {
+    size_t J = I;
+    while (J + 1 < Idx.size() && Idx[J + 1] == Idx[J] + 1)
+      ++J;
+    if (!S.empty())
+      OS << ',';
+    if (I == J)
+      OS << Kind << Idx[I];
+    else
+      OS << Kind << '[' << Idx[I] << ':' << Idx[J] << ']';
+    I = J + 1;
+  }
+  return S;
+}
