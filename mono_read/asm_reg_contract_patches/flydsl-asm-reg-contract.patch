+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 FlyDSL Project Contributors
+
+"""Register-contract ASM functions.
+
+A register-contract function wraps a hand-written AMDGPU assembly fragment as
+an LLVM function whose parameters live in fixed registers and whose register
+footprint is declared up front.  The AMDGPU backend (``amdgpu-contract``
+attributes) expands each call in place: there is no call ABI, no stack and no
+register save/restore.  Live caller values are kept out of the footprint by the
+register allocator, and the backend reports (or rejects) any spill around the
+call.
+
+Offline, :func:`pack` turns ``fragment.s`` plus a manifest into
+``<name>.contract.bc`` and a ``<name>.contract.json`` sidecar::
+
+    name: dq_convert
+    source: dq_convert.inline.s
+    symbol: mono_dq_convert_inline_fragment
+    target: gfx1250
+    align: 64                       # optional: keep the fragment 64B aligned
+    params:
+      - {name: args, reg: "s[0:1]", type: uint64}   # SGPR params must be uniform
+      - {name: lane, reg: v0,       type: uint32}
+      - {name: wave, reg: s24,      type: uint32}
+    clobbers: [ "s[2:23]", "s[25:29]", "s[40:48]", "v[4:45]", scc ]   # optional
+    preserves: [exec, mode]         # written, but restored by the fragment
+    memory: true                    # the fragment reads/writes memory
+
+In a kernel, :func:`ffi_contract` loads the sidecar and emits the call::
+
+    dq = ffi_contract("build/dq_convert.contract.json")
+    dq(args=addr, lane=tid & 31, wave=tid >> 5)
+
+Final code generation must use an LLVM with the contract passes, selected with
+``FLYDSL_COMPILE_LLVM_DIR``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import inspect
+import json
+import os
+import re
+import subprocess
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Sequence
+
+SIDECAR_VERSION = 1
+SITE_MARKER = ";@amdgpu-contract-site"
+FORBIDDEN_SPECIAL_WRITES = ("exec", "mode", "m0", "vcc")
+
+_INT_TYPES = {"int32": "i32", "uint32": "i32", "int64": "i64", "uint64": "i64"}
+
+
+class ContractError(RuntimeError):
+    """Raised when a fragment does not satisfy its register contract."""
+
+
+# --------------------------------------------------------------------------- #
+# Register sets
+# --------------------------------------------------------------------------- #
+
+_REG_RE = re.compile(r"^([sv])(?:(\d+)|\[(\d+):(\d+)\])$")
+
+
+def parse_regs(items) -> set:
+    """Parse ``["s[2:23]", "v4", "scc"]`` (or a comma string) into a set.
+
+    GPRs become ``("s", 5)`` / ``("v", 4)`` tuples, others stay names.
+    """
+    if isinstance(items, str):
+        items = [p for p in items.split(",")]
+    out = set()
+    for raw in items:
+        item = str(raw).strip().lower()
+        if not item:
+            continue
+        m = _REG_RE.match(item)
+        if not m:
+            out.add(item)
+            continue
+        kind = m.group(1)
+        lo = int(m.group(2) if m.group(2) is not None else m.group(3))
+        hi = int(m.group(2) if m.group(2) is not None else m.group(4))
+        if hi < lo:
+            raise ContractError(f"bad register range {raw!r}")
+        out.update((kind, i) for i in range(lo, hi + 1))
+    return out
+
+
+def format_regs(regs: set) -> str:
+    parts = []
+    for kind in ("s", "v"):
+        idx = sorted(i for k, i in (r for r in regs if isinstance(r, tuple)) if k == kind)
+        i = 0
+        while i < len(idx):
+            j = i
+            while j + 1 < len(idx) and idx[j + 1] == idx[j] + 1:
+                j += 1
+            parts.append(f"{kind}{idx[i]}" if i == j else f"{kind}[{idx[i]}:{idx[j]}]")
+            i = j + 1
+    parts.extend(sorted(r for r in regs if isinstance(r, str)))
+    return ",".join(parts)
+
+
+def _single_reg_count(reg: str) -> tuple:
+    regs = parse_regs([reg])
+    kinds = {r[0] for r in regs if isinstance(r, tuple)}
+    if len(kinds) != 1 or len(regs) not in (1, 2):
+        raise ContractError(f"parameter register {reg!r} must be one or two SGPRs or VGPRs")
+    idx = sorted(r[1] for r in regs)
+    if idx[-1] - idx[0] + 1 != len(idx):
+        raise ContractError(f"parameter register {reg!r} is not contiguous")
+    if len(idx) == 2 and kinds == {"s"} and idx[0] % 2:
+        raise ContractError(f"64-bit SGPR parameter {reg!r} must start at an even SGPR")
+    return kinds.pop(), len(idx)
+
+
+# --------------------------------------------------------------------------- #
+# Manifest
+# --------------------------------------------------------------------------- #
+
+
+@dataclass
+class Param:
+    name: str
+    reg: str
+    type: str
+
+    @property
+    def kind(self) -> str:
+        return _single_reg_count(self.reg)[0]
+
+    @property
+    def llvm_type(self) -> str:
+        return _INT_TYPES[self.type]
+
+
+@dataclass
+class Manifest:
+    name: str
+    source: Path
+    target: str = "gfx1250"
+    symbol: Optional[str] = None
+    align: int = 0
+    params: List[Param] = field(default_factory=list)
+    clobbers: Optional[List[str]] = None
+    preserves: List[str] = field(default_factory=list)
+    memory: bool = True
+
+    @classmethod
+    def load(cls, path) -> "Manifest":
+        path = Path(path)
+        text = path.read_text(encoding="utf-8")
+        if path.suffix in (".yaml", ".yml"):
+            import yaml
+
+            data = yaml.safe_load(text)
+        else:
+            data = json.loads(text)
+        return cls.from_dict(data, base=path.parent)
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any], base: Path = Path(".")) -> "Manifest":
+        known = {"name", "source", "target", "symbol", "align", "params", "clobbers", "preserves", "memory"}
+        unknown = set(data) - known
+        if unknown:
+            raise ContractError(f"unknown manifest keys: {sorted(unknown)}")
+        name = str(data["name"])
+        if not re.match(r"^[A-Za-z_][A-Za-z0-9_.]*$", name):
+            raise ContractError(f"contract name {name!r} is not a valid symbol")
+        params = []
+        for p in data.get("params", []):
+            ptype = str(p.get("type", "uint32"))
+            if ptype not in _INT_TYPES:
+                raise ContractError(f"param {p.get('name')!r}: type must be one of {sorted(_INT_TYPES)}")
+            param = Param(str(p["name"]), str(p["reg"]).lower().replace(" ", ""), ptype)
+            kind, count = _single_reg_count(param.reg)
+            if count * 32 != int(param.llvm_type[1:]):
+                raise ContractError(f"param {param.name!r}: {param.type} does not fit {param.reg}")
+            params.append(param)
+        names = [p.name for p in params]
+        if len(set(names)) != len(names):
+            raise ContractError("duplicate parameter names")
+        source = Path(data["source"])
+        if not source.is_absolute():
+            source = (base / source).resolve()
+        clobbers = data.get("clobbers")
+        if isinstance(clobbers, str):
+            clobbers = [c for c in clobbers.split(",")]
+        align = int(data.get("align", 0) or 0)
+        if align and align & (align - 1):
+            raise ContractError("align must be a power of two")
+        return cls(
+            name=name,
+            source=source,
+            target=str(data.get("target", "gfx1250")),
+            symbol=data.get("symbol"),
+            align=align,
+            params=params,
+            clobbers=clobbers,
+            preserves=[str(p).lower() for p in data.get("preserves", [])],
+            memory=bool(data.get("memory", True)),
+        )
+
+
+# --------------------------------------------------------------------------- #
+# Packing
+# --------------------------------------------------------------------------- #
+
+
+def _llvm_bin(llvm_dir: Optional[str]) -> Path:
+    raw = llvm_dir or os.environ.get("FLYDSL_COMPILE_LLVM_DIR", "")
+    if not raw:
+        raise ContractError("pass --llvm-dir or set FLYDSL_COMPILE_LLVM_DIR to an LLVM with the contract passes")
+    prefix = Path(raw).expanduser().resolve()
+    return prefix / "bin"
+
+
+def _run(cmd: Sequence[str]) -> str:
+    proc = subprocess.run([str(c) for c in cmd], capture_output=True, text=True)
+    if proc.returncode:
+        raise ContractError(f"command failed: {' '.join(map(str, cmd))}\n{proc.stderr}")
+    return proc.stdout
+
+
+def _sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _escape_ll(s: str) -> str:
+    out = []
+    for ch in s:
+        if ch == '"' or ch == "\\" or not (" " <= ch <= "~"):
+            out.append(f"\\{ord(ch):02X}")
+        else:
+            out.append(ch)
+    return "".join(out)
+
+
+def _generate_ll(m: Manifest, words: List[int], clobber: str) -> str:
+    asm_lines = []
+    if m.align:
+        # Keep the fragment's alignment; a numeric label is safe to repeat.
+        asm_lines += ["s_branch 1f", f".p2align {m.align.bit_length() - 1}", "1:"]
+    asm_lines += [f".long 0x{w:08x}" for w in words]
+    asm = "\n".join(asm_lines) + "\n"
+
+    constraints = [f"{{{p.reg}}}" for p in m.params]
+    constraints += [f"~{{{c}}}" for c in clobber.split(",") if c]
+    if m.memory:
+        constraints.append("~{memory}")
+
+    args = ", ".join(f'{p.llvm_type} "amdgpu-reg"="{p.reg}" %{p.name}' for p in m.params)
+    body = []
+    operands = []
+    for p in m.params:
+        if p.kind == "s":
+            # The value must be wave-uniform; this makes it legal in an SGPR.
+            body.append(
+                f"  %{p.name}.u = call {p.llvm_type} @llvm.amdgcn.readfirstlane.{p.llvm_type}({p.llvm_type} %{p.name})"
+            )
+            operands.append(f"{p.llvm_type} %{p.name}.u")
+        else:
+            operands.append(f"{p.llvm_type} %{p.name}")
+
+    decls = sorted(
+        {
+            f"declare {p.llvm_type} @llvm.amdgcn.readfirstlane.{p.llvm_type}({p.llvm_type})"
+            for p in m.params
+            if p.kind == "s"
+        }
+    )
+    lines = [
+        f"; Generated by flydsl.compiler.asm_contract from {m.source.name}. Do not edit.",
+        'target triple = "amdgcn-amd-amdhsa"',
+        "",
+        f"define void @{m.name}({args}) #0 {{",
+        *body,
+        f'  call void asm sideeffect "{_escape_ll(asm)}", "{",".join(constraints)}"({", ".join(operands)})',
+        "  ret void",
+        "}",
+        "",
+        *decls,
+        "",
+        f'attributes #0 = {{ noinline convergent nounwind "amdgpu-contract"="{m.name}" '
+        f'"amdgpu-contract-clobber"="{clobber}" "target-cpu"="{m.target}" }}',
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def check_footprint(m: Manifest, fp: Dict[str, Any]) -> tuple:
+    """Check a footprint against the manifest. Returns (clobber, warnings)."""
+    errors, warnings = [], list(fp.get("warnings", []))
+    writes_gpr = parse_regs(fp["writes"]["sgpr"]) | parse_regs(fp["writes"]["vgpr"])
+    writes_special = set(fp["writes"]["special"])
+    preserves = set(m.preserves)
+
+    if fp["forbidden"]:
+        ops = ", ".join(f"{f['opcode']}@{f['offset']}" for f in fp["forbidden"])
+        errors.append(f"forbidden control flow in fragment: {ops}")
+    if fp["has_relocations"]:
+        errors.append("fragment has relocations; it must be position independent")
+    if fp["vgpr_msb_exit"] != 0:
+        errors.append(f"fragment ends with VGPR MSBs 0x{fp['vgpr_msb_exit']:x}; restore s_set_vgpr_msb 0")
+
+    inputs = set()
+    for p in m.params:
+        inputs |= parse_regs([p.reg])
+    written_inputs = inputs & writes_gpr
+    if written_inputs:
+        errors.append(f"fragment writes input register(s) {format_regs(written_inputs)}")
+
+    special_clobber = writes_special - preserves
+    if m.clobbers is None:
+        declared = writes_gpr | special_clobber
+    else:
+        declared = parse_regs(m.clobbers)
+        missing = (writes_gpr | special_clobber) - declared
+        if missing:
+            errors.append(f"fragment writes {format_regs(missing)}, which is not in clobbers")
+        unused = {r for r in declared - writes_gpr - writes_special if r != "memory"}
+        if unused:
+            warnings.append(f"clobbers {format_regs(unused)} are declared but never written")
+        if declared & inputs:
+            errors.append(f"clobbers overlap the inputs: {format_regs(declared & inputs)}")
+    declared.discard("memory")
+    bad_special = {r for r in declared if isinstance(r, str)} & set(FORBIDDEN_SPECIAL_WRITES) - {"vcc"}
+    if bad_special:
+        errors.append(
+            f"fragment changes {', '.join(sorted(bad_special))}; restore it inside the fragment "
+            "and list it under 'preserves'"
+        )
+    if errors:
+        raise ContractError(f"contract {m.name!r}:\n  " + "\n  ".join(errors))
+    return format_regs(declared), warnings
+
+
+def pack(manifest, out_dir, *, llvm_dir: Optional[str] = None) -> Dict[str, Any]:
+    """Assemble, audit and package a fragment. Returns the sidecar dict."""
+    m = manifest if isinstance(manifest, Manifest) else Manifest.load(manifest)
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    bin_dir = _llvm_bin(llvm_dir)
+
+    src = m.source.read_bytes()
+    obj = out_dir / f"{m.name}.fragment.o"
+    _run([bin_dir / "llvm-mc", "-triple=amdgcn-amd-amdhsa", f"-mcpu={m.target}", "-filetype=obj", m.source, "-o", obj])
+    code_path = out_dir / f"{m.name}.fragment.bin"
+    fp_cmd = [bin_dir / "amdgpu-asm-footprint", obj, f"-mcpu={m.target}", f"--bytes-out={code_path}"]
+    if m.symbol:
+        fp_cmd.append(f"--symbol={m.symbol}")
+    fp = json.loads(_run(fp_cmd))
+    clobber, warnings = check_footprint(m, fp)
+
+    code = code_path.read_bytes()
+    if len(code) % 4:
+        raise ContractError("fragment size is not a multiple of 4 bytes")
+    words = [int.from_bytes(code[i : i + 4], "little") for i in range(0, len(code), 4)]
+
+    ll_path = out_dir / f"{m.name}.contract.ll"
+    bc_path = out_dir / f"{m.name}.contract.bc"
+    ll_path.write_text(_generate_ll(m, words, clobber), encoding="utf-8")
+    _run([bin_dir / "llvm-as", ll_path, "-o", bc_path])
+
+    sidecar = {
+        "version": SIDECAR_VERSION,
+        "name": m.name,
+        "symbol": m.name,
+        "target": m.target,
+        "bitcode": bc_path.name,
+        "params": [{"name": p.name, "reg": p.reg, "type": p.type} for p in m.params],
+        "clobber": clobber,
+        "preserves": m.preserves,
+        "memory": m.memory,
+        "source": str(m.source),
+        "source_sha256": _sha256(src),
+        "fragment_bytes": len(code),
+        "fragment_sha256": _sha256(code),
+        "footprint": {"writes": fp["writes"], "reads": fp["reads"], "instructions": fp["instructions"]},
+        "warnings": warnings,
+    }
+    (out_dir / f"{m.name}.contract.json").write_text(json.dumps(sidecar, indent=2) + "\n", encoding="utf-8")
+    return sidecar
+
+
+# --------------------------------------------------------------------------- #
+# Kernel-side call
+# --------------------------------------------------------------------------- #
+
+
+def _user_site(depth: int = 3) -> str:
+    """``file:line`` of the innermost user frames, innermost first."""
+    from ..expr.meta import _is_framework_file
+
+    sites = []
+    frame = inspect.currentframe()
+    try:
+        while frame is not None and len(sites) < depth:
+            if not _is_framework_file(frame.f_code.co_filename):
+                sites.append(f"{os.path.basename(frame.f_code.co_filename)}:{frame.f_lineno}")
+            frame = frame.f_back
+    finally:
+        del frame
+    # The site goes into asm text and a JSON report; keep it to one token.
+    return "<".join(sites) or "unknown"
+
+
+class ContractFunction:
+    """Kernel-side callable for a packed register-contract function."""
+
+    def __init__(self, sidecar_path):
+        from ..expr.extern import ExternFunction
+
+        self.sidecar_path = Path(sidecar_path).resolve()
+        data = json.loads(self.sidecar_path.read_text(encoding="utf-8"))
+        if data.get("version") != SIDECAR_VERSION:
+            raise ContractError(f"{self.sidecar_path}: unsupported sidecar version {data.get('version')}")
+        self.info = data
+        self.name = data["name"]
+        self.params = data["params"]
+        self.bitcode_path = str(self.sidecar_path.parent / data["bitcode"])
+        self._extern = ExternFunction(data["symbol"], [p["type"] for p in self.params], "void", convergent=True)
+
+    @property
+    def clobber(self) -> str:
+        return self.info["clobber"]
+
+    def __call__(self, *args, **kwargs):
+        from .._mlir.dialects import llvm
+        from .extern_link import _register_link_metadata
+
+        names = [p["name"] for p in self.params]
+        if len(args) > len(names):
+            raise TypeError(f"{self.name}() takes {len(names)} argument(s), got {len(args)}")
+        values = dict(zip(names, args))
+        for k, v in kwargs.items():
+            if k not in names:
+                raise TypeError(f"{self.name}() got an unexpected argument {k!r}; parameters: {names}")
+            if k in values:
+                raise TypeError(f"{self.name}() got multiple values for {k!r}")
+            values[k] = v
+        missing = [n for n in names if n not in values]
+        if missing:
+            raise TypeError(f"{self.name}() missing argument(s): {missing}")
+
+        _register_link_metadata(self.bitcode_path, None)
+        # Must immediately precede the call; the backend consumes it.
+        llvm.inline_asm(
+            None,
+            [],
+            f"{SITE_MARKER} {_user_site()}",
+            "",
+            has_side_effects=True,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+        )
+        return self._extern(*[values[n] for n in names])
+
+    def __repr__(self) -> str:
+        regs = ", ".join(f"{p['name']}@{p['reg']}" for p in self.params)
+        return f"ffi_contract({self.name}: {regs}; clobber={self.clobber})"
+
+
+def ffi_contract(sidecar_path) -> ContractFunction:
+    """Load ``<name>.contract.json`` written by :func:`pack`."""
+    return ContractFunction(sidecar_path)
+
+
+def spill_hints(policy: str = "error", *, sgpr_lane_spill_max: int = 0, report: Optional[str] = None) -> dict:
+    """LLVM options for the contract checks, for ``compile_hints['llvm_options']``."""
+    if policy not in ("allow", "error"):
+        raise ValueError("policy must be 'allow' or 'error'")
+    opts = {"amdgpu-spill-policy": policy, "amdgpu-sgpr-lane-spill-max": int(sgpr_lane_spill_max)}
+    if report:
+        opts["amdgpu-contract-report"] = str(report)
+    return opts
+
+
+# --------------------------------------------------------------------------- #
+# CLI
+# --------------------------------------------------------------------------- #
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    ap = argparse.ArgumentParser(prog="python -m flydsl.compiler.asm_contract", description=__doc__.split("\n\n")[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("pack", help="assemble, audit and package a fragment")
+    p.add_argument("manifest")
+    p.add_argument("-o", "--out-dir", required=True)
+    p.add_argument("--llvm-dir", default=None)
+    a = ap.parse_args(argv)
+    try:
+        info = pack(a.manifest, a.out_dir, llvm_dir=a.llvm_dir)
+    except ContractError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    for w in info["warnings"]:
+        print(f"warning: {w}", file=sys.stderr)
+    fpw = info["footprint"]["writes"]
+    print(
+        f"{info['name']}: {info['fragment_bytes']} bytes, params "
+        + ", ".join(f"{p['name']}@{p['reg']}" for p in info["params"])
+        + f"; clobber {info['clobber']} ({fpw['num_sgpr']} SGPR, {fpw['num_vgpr']} VGPR written)"
+    )
+    print(f"  -> {Path(a.out_dir) / info['bitcode']}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
