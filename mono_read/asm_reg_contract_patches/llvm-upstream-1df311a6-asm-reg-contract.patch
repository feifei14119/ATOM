diff --git a/llvm/test/tools/amdgpu-asm-footprint/basic.s b/llvm/test/tools/amdgpu-asm-footprint/basic.s
new file mode 100644
index 000000000..7cd7cbdc9
--- /dev/null
+++ b/llvm/test/tools/amdgpu-asm-footprint/basic.s
@@ -0,0 +1,45 @@
+# RUN: llvm-mc -triple=amdgcn-amd-amdhsa -mcpu=gfx1250 -filetype=obj %s -o %t.o
+# RUN: amdgpu-asm-footprint %t.o -mcpu=gfx1250 --symbol=frag | FileCheck --check-prefix=FRAG %s
+# RUN: amdgpu-asm-footprint %t.o -mcpu=gfx1250 --symbol=leaks_msb | FileCheck --check-prefix=LEAK %s
+
+# Writes come from the instruction descriptions; v256 and up are found by
+# following s_set_vgpr_msb.
+
+  .text
+  .globl frag
+  .type frag,@function
+frag:
+  s_mov_b32 s5, 1
+  s_cmp_eq_u32 s0, 0
+  v_mov_b32 v3, v1
+  s_set_vgpr_msb 0x40
+  v_mov_b32 v0, v1
+  s_set_vgpr_msb 0
+  s_endpgm
+  .size frag, .-frag
+
+  .globl leaks_msb
+  .type leaks_msb,@function
+leaks_msb:
+  s_set_vgpr_msb 0x40
+  v_mov_b32 v7, v1
+  .size leaks_msb, .-leaks_msb
+
