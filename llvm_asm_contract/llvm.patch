index 000000000000..3f5992ee1d40
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/asm-call-contract-errors.ll
@@ -0,0 +1,111 @@
+; RUN: split-file %s %t
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/version.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=VERSION
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/overlap.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=OVERLAP
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/width.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=WIDTH
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/reserved.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=RESERVED
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/extent.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=EXTENT
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/private.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=PRIVATE
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/fullwave.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=FULLWAVE
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/divergent-arg.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=DIVERGENT-ARG
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/divergent-call.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=DIVERGENT-CALL
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/escape.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=ESCAPE
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/definition.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=DEFINITION
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -global-isel=0 %t/budget.ll -o /dev/null 2>&1 | FileCheck %s --check-prefix=BUDGET
+
+; VERSION: unsupported contract version (expected 1)
+; OVERLAP: overlapping argument register bindings
+; WIDTH: register width must match a 32/64-bit scalar argument or result
+; RESERVED: s[30:39] are reserved for call state
+; EXTENT: register use exceeds declared resource extent
+; PRIVATE: version 1 forbids private memory
+; FULLWAVE: caller must explicitly assert amdgpu-asm-full-wave-calls=true
+; DIVERGENT-ARG: divergent argument 0 cannot bind to an SGPR
+; DIVERGENT-CALL: call is controlled by a divergent branch
+; ESCAPE: version 1 forbids address escapes, aliases, and signature casts
+; DEFINITION: definitions are unsupported; provide an external assembly object
+; BUDGET: callee register resource extent exceeds caller allocation budget
+
+;--- version.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="999" }
+
+;--- overlap.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage(i32, i32) #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="s0,s0" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- width.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage(i64) #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="v0" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="2" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- reserved.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="s30" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- extent.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="v64" "amdgpu-asm-vgpr-count"="64" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- private.ll
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="4" }
+
+;--- fullwave.ll
+define amdgpu_kernel void @caller() {
+  call void @stage()
+  ret void
+}
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- budget.ll
+define amdgpu_kernel void @caller() #1 {
+  call void @stage()
+  ret void
+}
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="v95" "amdgpu-asm-vgpr-count"="96" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+attributes #1 = { "amdgpu-asm-full-wave-calls"="true" "amdgpu-num-vgpr"="64" }
+
+;--- divergent-arg.ll
+define amdgpu_kernel void @caller() #1 {
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  call void @stage(i32 %tid)
+  ret void
+}
+declare i32 @llvm.amdgcn.workitem.id.x()
+declare void @stage(i32) #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="s0" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+attributes #1 = { "amdgpu-asm-full-wave-calls"="true" }
+
+;--- divergent-call.ll
+define amdgpu_kernel void @caller() #1 {
+entry:
+  %tid = call i32 @llvm.amdgcn.workitem.id.x()
+  %take = icmp ult i32 %tid, 16
+  br i1 %take, label %partial, label %exit
+partial:
+  call void @stage()
+  br label %exit
+exit:
+  ret void
+}
+declare i32 @llvm.amdgcn.workitem.id.x()
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+attributes #1 = { "amdgpu-asm-full-wave-calls"="true" }
+
+;--- escape.ll
+@address = global ptr @stage
+define amdgpu_kernel void @caller() { ret void }
+declare void @stage() #0
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
+
+;--- definition.ll
+define void @stage() #0 { ret void }
+attributes #0 = { convergent nounwind norecurse "amdgpu-asm-contract"="1" "amdgpu-asm-arg-regs"="" "amdgpu-asm-clobbers"="" "amdgpu-asm-vgpr-count"="0" "amdgpu-asm-sgpr-count"="32" "amdgpu-asm-private-bytes"="0" }
diff --git a/llvm/test/CodeGen/AMDGPU/asm-call-contract.ll b/llvm/test/CodeGen/AMDGPU/asm-call-contract.ll
new file mode 100644
index 000000000000..49780a5396ef
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/asm-call-contract.ll
@@ -0,0 +1,75 @@
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -mattr=+wavefrontsize32 -global-isel=0 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -mattr=+wavefrontsize32 -global-isel=0 -stop-after=finalize-isel < %s | FileCheck %s --check-prefixes=MIR,MASK
+; RUN: not llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1250 -mattr=+wavefrontsize32 -global-isel=1 < %s 2>&1 | FileCheck %s --check-prefix=GISEL
+
+; A real device call, with no default ABI argument record and no wrapper. The
+; lane-dependent value and global address remain live across the destructive
+; assembly call. Resource extents include the callee's highest physical indices.
+
+; CHECK-LABEL: caller:
+; CHECK: s_mov_b32 s2, 7
+; CHECK: s_swap_pc_i64 s[30:31]
+; CHECK: .amdhsa_next_free_vgpr 96
+; CHECK: .amdhsa_next_free_sgpr 66
+; MIR-LABEL: name: caller
+; MIR: $sgpr0 = COPY
+; MIR: $sgpr1 = COPY
+; MIR: $vgpr0 = COPY
+; MIR: $vgpr1 = COPY
+; MIR: $vgpr2 = COPY
+; MIR: $vgpr3 = COPY
+; MIR: $sgpr2 = COPY
+; MIR: SI_CALL
+; MASK-SAME: CustomRegMask(
+; MASK-NOT: $src_scc,
+; MASK-NOT: $sgpr4,
+; MASK-NOT: $sgpr4_sgpr5,
+; MASK-NOT: $vgpr4,
+; MASK-NOT: $vgpr64,
+; MASK-NOT: $vgpr63_vgpr64,
+; MASK: implicit $sgpr0
+; MIR: COPY $vgpr4
+; GISEL: AMDGPU ASM contract: GlobalISel is not supported; use -global-isel=0
+define amdgpu_kernel void @caller(ptr addrspace(1) %output) #0 {
+entry:
+  %bx = call i32 @llvm.amdgcn.workgroup.id.x()
+  %by = call i32 @llvm.amdgcn.workgroup.id.y()
+  %tx = call i32 @llvm.amdgcn.workitem.id.x()
+  %ty = call i32 @llvm.amdgcn.workitem.id.y()
+  %address = ptrtoint ptr addrspace(1) %output to i64
+  %saved = mul i32 %tx, 13
+  %result = call i32 @stage(i32 %bx, i32 %by, i64 %address, i32 %tx, i32 %ty, i32 7)
+  %sum = add i32 %result, %saved
+  %slot = getelementptr i32, ptr addrspace(1) %output, i32 %tx
+  store i32 %sum, ptr addrspace(1) %slot, align 4
+  ret void
+}
+
+; Fixed 64-bit scalar input and 64-bit vector return are mapped after ordinary
+; calling-convention type splitting. The return tuple is a definition even if
+; the supplier's explicit clobber list is empty.
+; CHECK-LABEL: caller64:
+; CHECK: s_swap_pc_i64 s[30:31]
+; MIR-LABEL: name: caller64
+; MIR: $sgpr0 = COPY
+; MIR: $sgpr1 = COPY
+; MIR: SI_CALL
+; MIR: COPY $vgpr8
+; MIR: COPY $vgpr9
+define amdgpu_kernel void @caller64(ptr addrspace(1) %output) #0 {
+  %address = ptrtoint ptr addrspace(1) %output to i64
+  %result = call i64 @stage64(i64 %address)
+  store i64 %result, ptr addrspace(1) %output, align 8
+  ret void
