index 000000000000..07bb46f4e21d
--- /dev/null
+++ b/llvm/lib/Target/AMDGPU/AMDGPUAsmCallContract.h
@@ -0,0 +1,55 @@
+//===- AMDGPUAsmCallContract.h - External assembly calls ----------*- C++
+//-*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_AMDGPU_AMDGPUASMCALLCONTRACT_H
+#define LLVM_LIB_TARGET_AMDGPU_AMDGPUASMCALLCONTRACT_H
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/MC/MCRegister.h"
+#include "llvm/Support/Error.h"
+#include <optional>
+
+namespace llvm {
+class Function;
+class GCNSubtarget;
+class MachineFunction;
+
+/// Experimental, versioned ABI for a directly called external leaf assembly
+/// function. Version 1 requires full EXEC, preserves all execution state except
+/// explicitly declared SCC/VCC clobbers, and uses s[30:31] for the return PC.
+/// The object supplier is responsible for fulfilling this contract.
+struct AMDGPUAsmCallContract {
+  struct RegisterSpan {
+    char Kind;
+    unsigned First;
+    unsigned Count;
+    MCRegister getDWord(unsigned Part = 0) const;
+  };
+
+  SmallVector<RegisterSpan, 8> ArgRegs;
+  std::optional<RegisterSpan> ResultReg;
+  SmallVector<MCRegister, 32> ClobberedRegs;
+  unsigned NumVGPRs = 0;
