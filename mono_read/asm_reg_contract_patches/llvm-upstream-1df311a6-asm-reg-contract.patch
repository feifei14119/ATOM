+TargetLowering::AsmOperandInfoVector
+SITargetLowering::ParseConstraints(const DataLayout &DL,
+                                   const TargetRegisterInfo *TRI,
+                                   const CallBase &Call) const {
+  AsmOperandInfoVector Ops = TargetLowering::ParseConstraints(DL, TRI, Call);
+  const Function &F = *Call.getFunction();
+  // Constraints are parsed several times per call; report each call once.
+  const bool Diagnose = !AsmDiagCalls.contains(&Call);
+  auto Error = [&](const Twine &Msg) {
+    if (!Diagnose)
+      return;
+    F.getContext().diagnose(DiagnosticInfoInlineAsm(Call, Msg, DS_Error));
+    AsmDiagCalls.insert(&Call);
+  };
+  // Register-contract asm (see AMDGPUContract.cpp) must fit the budget
+  // exactly; other asm keeps the reserved-register warning for clobbers.
+  const auto *IA = dyn_cast<InlineAsm>(Call.getCalledOperand());
+  const bool IsContract =
+      IA && StringRef(IA->getAsmString()).starts_with(";@amdgpu-contract ");
+
+  const unsigned AddressableVGPRs =
+      Subtarget->has1024AddressableVGPRs() ? 1024 : 256;
+  const unsigned MaxVGPRs = Subtarget->getMaxNumVGPRs(F);
+  const unsigned AddressableSGPRs = AMDGPU::SGPR_32RegClass.getNumRegs();
+
+  // A register range clobber "~{v[a:b]}" names the set {va, ..., vb}, whether
+  // or not it happens to be a legal tuple. Expanded clobbers go to the end so
+  // that operand numbers used by matching constraints stay valid.
+  AsmOperandInfoVector Expanded;
+  for (AsmOperandInfo &Op : Ops) {
+    if (Op.Codes.size() != 1)
+      continue;
+    auto [Kind, Idx, NumRegs] = AMDGPU::parseAsmConstraintPhysReg(Op.Codes[0]);
+    if (Kind != 'v' && Kind != 's')
+      continue;
+    const unsigned Last = Idx + NumRegs - 1;
+    const std::string Name =
+        NumRegs == 1 ? (Twine(Kind) + Twine(Idx)).str()
+                     : (Twine(Kind) + "[" + Twine(Idx) + ":" + Twine(Last) + "]")
+                           .str();
+    const bool IsClobber = Op.Type == InlineAsm::isClobber;
+    // Nonexistent operand registers are diagnosed when they are allocated;
+    // nonexistent clobbers would otherwise be dropped silently.
+    if (Kind == 'v' && Last >= AddressableVGPRs) {
+      if (IsClobber)
+        Error("inline asm clobbers " + Name + ", but " + Subtarget->getCPU() +
+              " only has " + Twine(AddressableVGPRs) + " VGPRs");
+      continue;
+    }
+    if (Kind == 'v' && Last >= MaxVGPRs && (!IsClobber || IsContract) &&
+        AMDGPU::isEntryFunctionCC(F.getCallingConv())) {
+      Error("inline asm " + Twine(IsClobber ? "clobbers" : "uses") + " " +
+            Name + ", but function '" + F.getName() + "' may use at most " +
+            Twine(MaxVGPRs) +
+            " VGPRs (see amdgpu-flat-work-group-size / amdgpu-waves-per-eu)");
+      continue;
+    }
+    if (Kind == 's' && Last >= AddressableSGPRs) {
+      if (IsClobber)
+        Error("inline asm clobbers " + Name + ", but only s0-s" +
+              Twine(AddressableSGPRs - 1) + " exist");
+      continue;
+    }
+    if (!IsClobber || NumRegs == 1 ||
+        getRegForInlineAsmConstraint(TRI, Op.Codes[0], MVT::Other).first)
+      continue;
+    Op.Codes[0] = (Twine("{") + Twine(Kind) + Twine(Idx) + "}").str();
+    for (unsigned I = Idx + 1; I <= Last; ++I) {
+      Expanded.push_back(Op);
+      Expanded.back().Codes[0] = (Twine("{") + Twine(Kind) + Twine(I) + "}").str();
+    }
+  }
+  llvm::append_range(Ops, Expanded);
+  return Ops;
+}
