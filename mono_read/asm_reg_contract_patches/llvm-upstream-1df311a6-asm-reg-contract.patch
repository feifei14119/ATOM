+//===----------------------------------------------------------------------===//
+// AMDGPUExpandContractCalls
+//===----------------------------------------------------------------------===//
+
+class AMDGPUExpandContractCalls : public ModulePass {
+public:
+  static char ID;
+  AMDGPUExpandContractCalls() : ModulePass(ID) {}
+  bool runOnModule(Module &M) override;
+  StringRef getPassName() const override {
+    return "AMDGPU Expand Register-Contract Calls";
+  }
+};
+
+void contractError(const Function &F, const Twine &Msg) {
+  F.getContext().diagnose(DiagnosticInfoGeneric(
+      Twine("contract function '") + F.getName() + "': " + Msg, DS_Error));
+}
+
+/// Check the shape of a contract function. Returns its inline asm call.
+CallInst *verifyContract(Function &F) {
+  if (F.isDeclaration()) {
+    contractError(F, "has no body; link the bitcode that defines it");
+    return nullptr;
+  }
+  if (F.size() != 1) {
+    contractError(F, "body must be a single basic block");
+    return nullptr;
+  }
+
+  RegNameSet Footprint;
+  std::string Err;
+  if (!parseRegList(F.getFnAttribute(ClobberAttr).getValueAsString(), Footprint,
+                    Err)) {
+    contractError(F, Twine(ClobberAttr) + ": " + Err);
+    return nullptr;
+  }
+
+  std::multiset<std::string> ParamRegs;
+  for (Argument &A : F.args()) {
+    Attribute R = F.getAttributes().getParamAttr(A.getArgNo(), RegAttr);
+    if (!R.isStringAttribute()) {
+      contractError(F, "parameter " + Twine(A.getArgNo()) + " has no '" +
+                           RegAttr + "' attribute");
+      return nullptr;
+    }
+    ParamRegs.insert(("{" + R.getValueAsString() + "}").str());
+  }
+
+  CallInst *Asm = nullptr;
+  for (Instruction &I : F.getEntryBlock()) {
+    if (isa<ReturnInst>(I) || isa<CastInst>(I) || isa<BinaryOperator>(I) ||
+        isa<ExtractValueInst>(I) || isa<InsertValueInst>(I))
+      continue;
+    if (auto *II = dyn_cast<IntrinsicInst>(&I)) {
+      switch (II->getIntrinsicID()) {
+      case Intrinsic::amdgcn_readfirstlane:
+      case Intrinsic::amdgcn_wave_id:
+      case Intrinsic::amdgcn_workitem_id_x:
+        continue;
+      default:
+        break;
+      }
+    }
+    auto *CI = dyn_cast<CallInst>(&I);
+    if (CI && CI->isInlineAsm() && !Asm) {
+      Asm = CI;
+      continue;
+    }
+    contractError(F, "body may only contain argument conversions, one inline "
+                     "asm call and ret; found: " +
+                         Twine(I.getOpcodeName()));
+    return nullptr;
+  }
+  if (!Asm) {
+    contractError(F, "body has no inline asm call");
+    return nullptr;
+  }
+
+  const InlineAsm *IA = cast<InlineAsm>(Asm->getCalledOperand());
+  std::multiset<std::string> InputRegs;
+  for (const InlineAsm::ConstraintInfo &CI : IA->ParseConstraints()) {
+    if (CI.Codes.size() != 1) {
+      contractError(F, "inline asm constraints must name one register each");
+      return nullptr;
+    }
+    const std::string &Code = CI.Codes[0];
+    if (CI.Type == InlineAsm::isInput) {
+      InputRegs.insert(Code);
+      continue;
+    }
+    RegNameSet Regs;
+    if (!parseRegList(Code, Regs, Err)) {
+      contractError(F, "inline asm constraint " + Twine(Code) + ": " + Err);
+      return nullptr;
+    }
+    for (const std::string &R : Regs) {
+      if (R == "memory" || Footprint.count(R))
+        continue;
+      contractError(F, "inline asm writes " + Twine(R) +
+                           ", which is not in " + ClobberAttr);
+      return nullptr;
+    }
+  }
+  if (InputRegs != ParamRegs) {
+    contractError(F, "inline asm inputs must be exactly the '" + Twine(RegAttr) +
+                         "' registers of the parameters");
+    return nullptr;
+  }
+  return Asm;
+}
+
+/// Replace \p CB by a copy of the contract body of \p F.
+void expandCall(CallBase &CB, Function &F, CallInst &Asm) {
+  std::string Site;
+  if (auto *Prev = dyn_cast_or_null<CallInst>(CB.getPrevNode())) {
+    if (auto *Marker = dyn_cast<InlineAsm>(Prev->getCalledOperand())) {
+      StringRef S = Marker->getAsmString();
+      if (S.consume_front(SiteMarker)) {
+        Site = S.trim().str();
+        Prev->eraseFromParent();
+      }
+    }
+  }
+  if (Site.empty())
+    if (const DebugLoc &DL = CB.getDebugLoc())
+      Site = (DL->getFilename() + ":" + Twine(DL.getLine())).str();
+
+  ValueToValueMapTy VMap;
+  for (Argument &A : F.args())
+    VMap[&A] = CB.getArgOperand(A.getArgNo());
+
+  Value *Ret = nullptr;
+  for (Instruction &I : F.getEntryBlock()) {
+    if (auto *RI = dyn_cast<ReturnInst>(&I)) {
+      if (Value *V = RI->getReturnValue()) {
+        Ret = VMap.lookup(V);
+        if (!Ret)
+          Ret = V;
+      }
+      break;
+    }
+    Instruction *New = I.clone();
+    New->insertBefore(CB.getIterator());
+    New->setDebugLoc(CB.getDebugLoc());
+    VMap[&I] = New;
+    RemapInstruction(New, VMap,
+                     RF_NoModuleLevelChanges | RF_IgnoreMissingLocals);
+    if (&I != &Asm)
+      continue;
+    auto *NewCall = cast<CallInst>(New);
+    const InlineAsm *IA = cast<InlineAsm>(NewCall->getCalledOperand());
+    std::string Header =
+        (Twine(AsmHeader) + F.getFnAttribute(ContractAttr).getValueAsString() +
+         " site=" + (Site.empty() ? StringRef("?") : StringRef(Site)) +
+         " clobber=" + F.getFnAttribute(ClobberAttr).getValueAsString() + "\n")
+            .str();
+    NewCall->setCalledOperand(InlineAsm::get(
+        IA->getFunctionType(), Header + IA->getAsmString().str(),
+        IA->getConstraintString(), IA->hasSideEffects(), IA->isAlignStack(),
+        IA->getDialect(), IA->canThrow()));
+    NewCall->addFnAttr(Attribute::Convergent);
+  }
+  if (!CB.getType()->isVoidTy())
+    CB.replaceAllUsesWith(Ret ? Ret : PoisonValue::get(CB.getType()));
+  CB.eraseFromParent();
+}
+
+bool AMDGPUExpandContractCalls::runOnModule(Module &M) {
+  bool Changed = false;
+  SmallVector<Function *, 4> Contracts;
+  for (Function &F : M)
+    if (F.hasFnAttribute(ContractAttr))
+      Contracts.push_back(&F);
+
+  for (Function *F : Contracts) {
+    if (F->use_empty())
+      continue;
+    CallInst *Asm = verifyContract(*F);
+    SmallVector<CallBase *, 8> Calls;
+    bool Valid = Asm != nullptr;
+    for (User *U : F->users()) {
+      auto *CB = dyn_cast<CallBase>(U);
+      if (!CB || CB->getCalledOperand() != F) {
+        if (Valid)
+          contractError(*F, "may only be called directly");
+        Valid = false;
+        continue;
+      }
+      if (CB->getFunction() == F) {
+        if (Valid)
+          contractError(*F, "may not call itself");
+        Valid = false;
+        continue;
+      }
+      Calls.push_back(CB);
+    }
+    if (Valid) {
+      for (CallBase *CB : Calls)
+        expandCall(*CB, *F, *Asm);
+    } else {
+      // Compilation has failed; drop the contract so that code generation
+      // does not compile it as an ordinary function and pile up follow-on
+      // diagnostics.
+      for (CallBase *CB : Calls) {
+        if (!CB->getType()->isVoidTy())
+          CB->replaceAllUsesWith(PoisonValue::get(CB->getType()));
+        CB->eraseFromParent();
+      }
+      F->replaceAllUsesWith(PoisonValue::get(F->getType()));
+    }
+    Changed = true;
+  }
+
+  for (Function *F : Contracts) {
+    if (F->use_empty()) {
+      F->eraseFromParent();
+      Changed = true;
+    }
+  }
+  return Changed;
+}
+
+//===----------------------------------------------------------------------===//
+// AMDGPUContractReport
+//===----------------------------------------------------------------------===//
+
+class AMDGPUContractReport : public MachineFunctionPass {
+public:
+  static char ID;
+  AMDGPUContractReport() : MachineFunctionPass(ID) {}
+  bool runOnMachineFunction(MachineFunction &MF) override;
+  StringRef getPassName() const override {
+    return "AMDGPU Register-Contract Report";
+  }
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesAll();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+};
+
+struct CallSiteInfo {
+  std::string Contract, Site, Clobber;
+  SmallVector<unsigned, 16> LiveVGPRs, LiveSGPRs;
+  unsigned FreeVGPRs = 0, FreeSGPRs = 0;
+};
+
+struct SpillInfo {
+  std::string What;
+  std::string After; // closest contract call in the same block
+};
+
+bool AMDGPUContractReport::runOnMachineFunction(MachineFunction &MF) {
+  const Function &F = MF.getFunction();
+  const GCNSubtarget &ST = MF.getSubtarget<GCNSubtarget>();
+  const SIRegisterInfo &TRI = *ST.getRegisterInfo();
+  const MachineRegisterInfo &MRI = MF.getRegInfo();
+
+  StringRef Policy =
+      F.hasFnAttribute("amdgpu-spill-policy")
+          ? F.getFnAttribute("amdgpu-spill-policy").getValueAsString()
+          : StringRef(SpillPolicy);
+  const bool Strict = Policy == "error";
+  const unsigned LaneMax = F.getFnAttributeAsParsedInteger(
+      "amdgpu-sgpr-lane-spill-max", SGPRLaneSpillMax);
+  const bool WantReport = !ContractReportFile.empty();
+
+  const BitVector Reserved = TRI.getReservedRegs(MF);
+  const unsigned MaxVGPRs = ST.getMaxNumVGPRs(MF);
+
+  SmallVector<CallSiteInfo, 4> Sites;
+  SmallVector<SpillInfo, 4> VGPRSpills;
+  unsigned SGPRLaneSpills = 0;
+  std::string FirstLaneSpillAfter;
+
+  for (MachineBasicBlock &MBB : MF) {
+    // Contract calls in this block, in order, so a spill can name the
+    // closest preceding one.
+    std::string LastContract;
+    SmallVector<size_t, 4> PendingSpills;
+    auto Near = [&]() {
+      if (LastContract.empty())
+        return std::string();
+      return "after contract call " + LastContract;
+    };
+    for (MachineInstr &MI : MBB) {
+      if (MI.isInlineAsm()) {
+        StringRef S = MI.getOperand(InlineAsm::MIOp_AsmString).getSymbolName();
+        if (S.consume_front(AsmHeader)) {
+          StringRef Line = S.split('\n').first;
+          CallSiteInfo CS;
+          SmallVector<StringRef, 4> Fields;
+          Line.split(Fields, ' ', -1, false);
+          if (!Fields.empty())
+            CS.Contract = Fields[0].str();
+          for (StringRef Fld : drop_begin(Fields)) {
+            if (Fld.consume_front("site="))
+              CS.Site = Fld.str();
+            else if (Fld.consume_front("clobber="))
+              CS.Clobber = Fld.str();
+          }
+          LastContract = CS.Contract + "@" + CS.Site;
+          for (size_t I : PendingSpills)
+            VGPRSpills[I].After = "before contract call " + LastContract;
+          PendingSpills.clear();
+          Sites.push_back(std::move(CS));
+        }
+        continue;
+      }
+      if (SIInstrInfo::isSGPRSpill(MI)) {
+        if (MI.getOpcode() == AMDGPU::SI_SPILL_S32_TO_VGPR) {
+          if (!SGPRLaneSpills++)
+            FirstLaneSpillAfter = Near();
+        } else if (MI.mayStore()) {
+          if (LastContract.empty())
+            PendingSpills.push_back(VGPRSpills.size());
+          VGPRSpills.push_back(
+              {"SGPR spill to memory in bb." + std::to_string(MBB.getNumber()),
+               Near()});
+        }
+      } else if (SIInstrInfo::isVGPRSpill(MI) && MI.mayStore()) {
+        if (LastContract.empty())
+          PendingSpills.push_back(VGPRSpills.size());
+        VGPRSpills.push_back(
+            {"VGPR spill in bb." + std::to_string(MBB.getNumber()), Near()});
+      }
+    }
+  }
+
+  // Live-across registers of every contract call: live after the call and
+  // not written by it.
+  if (!Sites.empty() && MRI.tracksLiveness()) {
+    unsigned SiteIdx = 0;
+    SmallVector<std::pair<MachineInstr *, unsigned>, 4> SiteMIs;
+    for (MachineBasicBlock &MBB : MF)
+      for (MachineInstr &MI : MBB)
+        if (MI.isInlineAsm() &&
+            StringRef(MI.getOperand(InlineAsm::MIOp_AsmString).getSymbolName())
+                .starts_with(AsmHeader))
+          SiteMIs.push_back({&MI, SiteIdx++});
+
+    for (auto [SiteMI, Idx] : SiteMIs) {
+      SmallVector<std::string, 4> ReservedWrites;
+      for (const MachineOperand &MO : SiteMI->operands())
+        if (MO.isReg() && MO.isDef() && MO.getReg().isPhysical() &&
+            Reserved.test(MO.getReg()) &&
+            MO.getReg() != AMDGPU::SCC && MO.getReg() != AMDGPU::EXEC)
+          ReservedWrites.push_back(
+              AMDGPUInstPrinter::getRegisterName(MO.getReg()));
+      if (!ReservedWrites.empty())
+        F.getContext().diagnose(DiagnosticInfoGeneric(
+            "contract call " + Sites[Idx].Contract + "@" + Sites[Idx].Site +
+                " writes reserved register(s) " +
+                join(ReservedWrites, ", ") + " in function '" + F.getName() +
+                "'",
+            DS_Error));
+
+      MachineBasicBlock &MBB = *SiteMI->getParent();
+      LivePhysRegs Live(TRI);
+      Live.addLiveOuts(MBB);
+      for (MachineInstr &MI : reverse(MBB)) {
+        if (&MI == SiteMI)
+          break;
+        Live.stepBackward(MI);
+      }
+      CallSiteInfo &CS = Sites[Idx];
+      for (unsigned I = 0, E = AMDGPU::VGPR_32RegClass.getNumRegs(); I < E;
+           ++I) {
+        MCRegister R = AMDGPU::VGPR_32RegClass.getRegister(I);
+        bool Written = SiteMI->modifiesRegister(R, &TRI);
+        if (Live.contains(R) && !Written)
+          CS.LiveVGPRs.push_back(I);
+        if (I < MaxVGPRs && !Written && !Reserved.test(R))
+          ++CS.FreeVGPRs;
+      }
+      for (unsigned I = 0, E = AMDGPU::SGPR_32RegClass.getNumRegs(); I < E;
+           ++I) {
+        MCRegister R = AMDGPU::SGPR_32RegClass.getRegister(I);
+        bool Written = SiteMI->modifiesRegister(R, &TRI);
+        if (Live.contains(R) && !Written && !Reserved.test(R))
+          CS.LiveSGPRs.push_back(I);
+        if (!Written && !Reserved.test(R))
+          ++CS.FreeSGPRs;
+      }
+    }
+  }
+
+  const MachineFrameInfo &MFI = MF.getFrameInfo();
+  unsigned StackObjects = 0;
+  for (int FI = 0, E = MFI.getObjectIndexEnd(); FI < E; ++FI)
+    if (!MFI.isDeadObjectIndex(FI) && MFI.getObjectSize(FI) > 0 &&
+        !MFI.isSpillSlotObjectIndex(FI))
+      ++StackObjects;
+
+  std::string Status = "ok";
+  if (Strict) {
+    SmallString<256> Msg;
+    raw_svector_ostream OS(Msg);
+    for (const SpillInfo &S : VGPRSpills)
+      OS << "\n  " << S.What
+         << (S.After.empty() ? std::string() : " (" + S.After + ")");
+    if (SGPRLaneSpills > LaneMax)
+      OS << "\n  " << SGPRLaneSpills
+         << " SGPRs spilled to VGPR lanes, more than amdgpu-sgpr-lane-spill-max="
+         << LaneMax
+         << (FirstLaneSpillAfter.empty()
+                 ? std::string()
+                 : " (first one " + FirstLaneSpillAfter + ")");
+    if (StackObjects)
+      OS << "\n  " << StackObjects << " stack object(s) need scratch memory";
+    if (!Msg.empty()) {
+      Status = "error";
+      SmallString<512> Full;
+      raw_svector_ostream FOS(Full);
+      FOS << "function '" << F.getName()
+          << "' violates amdgpu-spill-policy=error:" << Msg;
+      for (const CallSiteInfo &CS : Sites)
+        FOS << "\n  contract call " << CS.Contract << "@" << CS.Site
+            << ": live across VGPR " << CS.LiveVGPRs.size() << " ["
+            << formatRegs('v', CS.LiveVGPRs) << "], SGPR "
+            << CS.LiveSGPRs.size() << ", free VGPR " << CS.FreeVGPRs
+            << ", free SGPR " << CS.FreeSGPRs;
+      if (WantReport)
+        FOS << "\n  see " << ContractReportFile;
+      F.getContext().diagnose(DiagnosticInfoGeneric(FOS.str(), DS_Error));
+    }
+  }
+
+  if (WantReport && (!Sites.empty() || Strict)) {
+    json::Array JSites;
+    for (const CallSiteInfo &CS : Sites)
+      JSites.push_back(json::Object{
+          {"contract", CS.Contract},
+          {"site", CS.Site},
+          {"clobber", CS.Clobber},
+          {"live_vgpr", (int64_t)CS.LiveVGPRs.size()},
+          {"live_sgpr", (int64_t)CS.LiveSGPRs.size()},
+          {"live_vgpr_regs", formatRegs('v', CS.LiveVGPRs)},
+          {"live_sgpr_regs", formatRegs('s', CS.LiveSGPRs)},
+          {"free_vgpr", (int64_t)CS.FreeVGPRs},
+          {"free_sgpr", (int64_t)CS.FreeSGPRs}});
+    json::Array JSpills;
+    for (const SpillInfo &S : VGPRSpills)
+      JSpills.push_back(json::Object{{"what", S.What}, {"near", S.After}});
+    json::Object Out{{"function", F.getName()},
+                     {"policy", Policy},
+                     {"max_vgpr", (int64_t)MaxVGPRs},
+                     {"callsites", std::move(JSites)},
+                     {"vgpr_spills", std::move(JSpills)},
+                     {"sgpr_lane_spills", (int64_t)SGPRLaneSpills},
+                     {"sgpr_lane_spill_max", (int64_t)LaneMax},
+                     {"stack_objects", (int64_t)StackObjects},
+                     {"status", Status}};
+    std::error_code EC;
+    raw_fd_ostream OS(ContractReportFile, EC, sys::fs::OF_Append);
+    if (EC)
+      F.getContext().diagnose(DiagnosticInfoGeneric(
+          "cannot write " + ContractReportFile + ": " + EC.message(),
+          DS_Warning));
+    else
+      OS << json::Value(std::move(Out)) << '\n';
+  }
+  return false;
+}
