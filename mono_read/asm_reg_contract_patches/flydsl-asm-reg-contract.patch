+
+@pytest.mark.skipif(not _LLVM_DIR, reason="set FLYDSL_TEST_CONTRACT_LLVM_DIR to an LLVM with the contract passes")
+def test_pack_real_fragment(tmp_path):
+    src = tmp_path / "frag.s"
+    src.write_text(
+        """  .text
+  .globl frag
+  .type frag,@function
+frag:
+  s_load_b32 s2, s[0:1], 0x0
+  s_wait_kmcnt 0
+  v_add_nc_u32 v4, s2, v0
+  s_set_vgpr_msb 0x40
+  v_mov_b32 v1, v4
+  s_set_vgpr_msb 0
+  .size frag, .-frag
+""",
+        encoding="utf-8",
+    )
+    manifest = tmp_path / "frag.json"
+    manifest.write_text(
+        json.dumps(
+            {
+                "name": "frag",
+                "source": "frag.s",
+                "symbol": "frag",
+                "params": [
+                    {"name": "args", "reg": "s[0:1]", "type": "uint64"},
+                    {"name": "lane", "reg": "v0", "type": "uint32"},
+                ],
+            }
+        ),
+        encoding="utf-8",
+    )
+    info = pack(manifest, tmp_path / "out", llvm_dir=_LLVM_DIR)
+    # v1 written with the dst MSB set is v257.
+    assert info["clobber"] == "s2,v4,v257"
+    assert (tmp_path / "out" / "frag.contract.bc").read_bytes()[:2] == b"BC"
+    sidecar = json.loads((tmp_path / "out" / "frag.contract.json").read_text(encoding="utf-8"))
+    assert sidecar["bitcode"] == "frag.contract.bc" and sidecar["fragment_bytes"] > 0
