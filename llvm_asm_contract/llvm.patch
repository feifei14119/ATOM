+
+void AMDGPUAsmPrinter::collectStrictPolicyFunctions(
+    const Function &F, unsigned Policy,
+    SmallPtrSetImpl<const Function *> &Active) {
+  if (Active.contains(&F)) {
+    strictPolicyError(F,
+                      "AMDGPU strict register policy cannot verify recursive "
+                      "calls");
+    return;
+  }
+  unsigned &Applied = StrictFunctionPolicies[&F];
+  if ((Applied & Policy) == Policy)
+    return;
+  Applied |= Policy;
+  Active.insert(&F);
+
+  for (const BasicBlock &BB : F) {
+    for (const Instruction &I : BB) {
+      const auto *CB = dyn_cast<CallBase>(&I);
+      if (!CB || CB->isInlineAsm())
+        continue;
+      const auto *Callee = dyn_cast<Function>(
+          CB->getCalledOperand()->stripPointerCastsAndAliases());
+      if (!Callee) {
+        strictPolicyError(F, "AMDGPU strict register policy cannot verify an "
+                             "indirect call");
+        continue;
+      }
+      if (Callee->isIntrinsic())
+        continue;
+      if (!Callee->isDeclaration()) {
+        collectStrictPolicyFunctions(*Callee, Policy, Active);
+        continue;
+      }
+      if (!hasAMDGPUAsmCallContract(*Callee)) {
+        strictPolicyError(F, "AMDGPU strict register policy requires an ASM "
+                             "contract for external callee '" +
+                                 Callee->getName() + "'");
+        continue;
+      }
+      auto Contract =
+          parseAMDGPUAsmCallContract(*Callee, TM.getSubtarget<GCNSubtarget>(F));
+      if (!Contract) {
+        strictPolicyError(F, toString(Contract.takeError()));
+        continue;
+      }
+      StrictFunctionPolicies[Callee] |= Policy;
+    }
+  }
+  Active.erase(&F);
+}
+
+void AMDGPUAsmPrinter::validateStrictFunctionPolicy(MachineFunction &MF) {
+  const Function &F = MF.getFunction();
+  unsigned Policy = StrictFunctionPolicies.lookup(&F);
+  if (!Policy && AsmContractReportPath.empty())
+    return;
+
+  const auto &MFI = *MF.getInfo<SIMachineFunctionInfo>();
+  const MachineFrameInfo &Frame = MF.getFrameInfo();
+  const GCNSubtarget &ST = MF.getSubtarget<GCNSubtarget>();
+  const SIInstrInfo &TII = *ST.getInstrInfo();
+  const SIRegisterInfo &TRI = *ST.getRegisterInfo();
+  unsigned SGPRLaneSaves = 0, SGPRMemorySaves = 0, CSRMemorySaves = 0;
+  for (const auto &Save : MFI.getPrologEpilogSGPRSpills()) {
+    SGPRLaneSaves += Save.second.getKind() == SGPRSaveKind::SPILL_TO_VGPR_LANE;
+    SGPRMemorySaves += Save.second.getKind() == SGPRSaveKind::SPILL_TO_MEM;
+  }
+  for (const CalleeSavedInfo &Save : Frame.getCalleeSavedInfo())
+    CSRMemorySaves += !Save.isSpilledToReg();
+
+  if ((Policy & NoGPRSpill) &&
+      (MFI.getNumSpilledSGPRs() || MFI.getNumSpilledVGPRs() || SGPRLaneSaves ||
+       SGPRMemorySaves || CSRMemorySaves || !MFI.getWWMSpills().empty()))
+    strictPolicyError(
+        F, "amdgpu-no-gpr-spill violated: generated GPR spill or "
+           "callee-saved spill (SGPR spill dwords=" +
+               Twine(MFI.getNumSpilledSGPRs()) +
+               ", VGPR spill dwords=" + Twine(MFI.getNumSpilledVGPRs()) +
+               ", SGPR ABI lane saves=" + Twine(SGPRLaneSaves) +
+               ", ABI memory saves=" + Twine(SGPRMemorySaves + CSRMemorySaves) +
+               ")");
+
+  if ((Policy & NoPrivateMemory) &&
+      (Frame.getStackSize() || Frame.hasVarSizedObjects() ||
+       MFI.getBytesInStackArgArea() || MFI.getScratchReservedForDynamicVGPRs()))
+    strictPolicyError(F, "amdgpu-no-private-memory violated: private frame, "
+                         "stack arguments or dynamic scratch (frame bytes=" +
+                             Twine(Frame.getStackSize()) +
+                             ", incoming stack argument bytes=" +
+                             Twine(MFI.getBytesInStackArgArea()) + ")");
+
+  unsigned PrivateAccesses = 0, OpaqueInlineAsms = 0;
+  json::Array Calls;
+  BitVector Allocatable = TRI.getAllocatableSet(MF);
+  auto RegName = [&TRI](MCRegister Reg) {
+    if (AMDGPU::SGPR_32RegClass.contains(Reg))
+      return ("s" + Twine(TRI.getHWRegIndex(Reg))).str();
+    if (AMDGPU::VGPR_32RegClass.contains(Reg))
+      return ("v" + Twine(TRI.getHWRegIndex(Reg))).str();
+    return std::string(TRI.getName(Reg));
+  };
+
+  for (const MachineBasicBlock &MBB : MF) {
+    LivePhysRegs Live(TRI);
+    Live.addLiveOuts(MBB);
+    for (const MachineInstr &MI : llvm::reverse(MBB)) {
+      if (MI.mayLoadOrStore() &&
+          (TII.mayAccessScratch(MI) ||
+           llvm::any_of(MI.memoperands(), [](const MachineMemOperand *MMO) {
+             return MMO->getAddrSpace() == AMDGPUAS::PRIVATE_ADDRESS;
+           })))
+        ++PrivateAccesses;
+
+      if (MI.isInlineAsm()) {
+        const MachineOperand &Text = MI.getOperand(InlineAsm::MIOp_AsmString);
+        if (Text.isSymbol() && !StringRef(Text.getSymbolName()).trim().empty())
+          ++OpaqueInlineAsms;
+      }
+
+      SmallVector<MCPhysReg, 32> LiveAfter;
+      if (MI.isCall())
+        LiveAfter.append(Live.begin(), Live.end());
+      Live.stepBackward(MI);
+      if (!MI.isCall())
+        continue;
+
+      const MachineOperand *CalleeOp =
+          TII.getNamedOperand(MI, AMDGPU::OpName::callee);
+      const Function *Callee = nullptr;
+      if (CalleeOp && CalleeOp->isGlobal())
+        Callee = dyn_cast<Function>(
+            CalleeOp->getGlobal()->stripPointerCastsAndAliases());
+      if (Policy && (!Callee || !StrictFunctionPolicies.count(Callee)))
+        strictPolicyError(F, "AMDGPU strict register policy encountered an "
+                             "unverified machine-code callee");
+
+      json::Array LiveThrough, Preserved;
+      // This describes the call instruction, after argument preparation. A
+      // before/after intersection alone is not enough: a result can redefine
+      // a register that also held an input. Exclude all call defs/regmasks.
+      llvm::sort(LiveAfter);
+      for (MCPhysReg Reg : LiveAfter) {
+        if ((AMDGPU::SGPR_32RegClass.contains(Reg) ||
+             AMDGPU::VGPR_32RegClass.contains(Reg)) &&
+            Live.contains(Reg) && !MI.modifiesRegister(Reg, &TRI))
+          LiveThrough.push_back(RegName(Reg));
+      }
+      for (const TargetRegisterClass *RC :
+           {&AMDGPU::SGPR_32RegClass, &AMDGPU::VGPR_32RegClass})
+        for (MCPhysReg Reg : RC->getRegisters())
+          if (Allocatable.test(Reg) && !MI.modifiesRegister(Reg, &TRI))
+            Preserved.push_back(RegName(Reg));
+
+      json::Object Call{
+          {"callee", Callee ? Callee->getName() : "<indirect>"},
+          {"machine_block", MBB.getNumber()},
+          {"call_instruction_live_through", std::move(LiveThrough)},
+          {"preserved_allocatable_gprs", std::move(Preserved)}};
+      if (Callee && hasAMDGPUAsmCallContract(*Callee)) {
+        Call["contract_version"] =
+            Callee->getFnAttribute("amdgpu-asm-contract").getValueAsString();
+        Call["full_wave_precondition"] = "caller_asserted";
+        for (StringRef Attr :
+             {"amdgpu-asm-arg-regs", "amdgpu-asm-result-reg",
+              "amdgpu-asm-clobbers", "amdgpu-asm-vgpr-count",
+              "amdgpu-asm-sgpr-count", "amdgpu-asm-private-bytes"})
+          if (Callee->hasFnAttribute(Attr))
+            Call[Attr] = Callee->getFnAttribute(Attr).getValueAsString();
+      }
+      Calls.push_back(std::move(Call));
+    }
+  }
+
+  if ((Policy & NoPrivateMemory) && PrivateAccesses)
+    strictPolicyError(
+        F, "amdgpu-no-private-memory violated: " + Twine(PrivateAccesses) +
+               " instruction(s) may access private memory");
+  if (Policy && OpaqueInlineAsms)
+    strictPolicyError(F,
+                      "AMDGPU strict register policy cannot verify nonempty "
+                      "inline assembly; use an audited external ASM contract");
+
+  if (!AsmContractReportPath.empty()) {
+    AsmContractReports.push_back(json::Object{
+        {"function", F.getName()},
+        {"no_gpr_spill", bool(Policy & NoGPRSpill)},
+        {"no_private_memory", bool(Policy & NoPrivateMemory)},
+        {"lowered_sgpr_spill_dwords", MFI.getNumSpilledSGPRs()},
+        {"lowered_vgpr_spill_dwords", MFI.getNumSpilledVGPRs()},
+        {"sgpr_abi_lane_saves", SGPRLaneSaves},
+        {"abi_memory_saves", SGPRMemorySaves + CSRMemorySaves},
+        {"wwm_spill_registers", MFI.getWWMSpills().size()},
+        {"private_frame_bytes", Frame.getStackSize()},
+        {"incoming_stack_argument_bytes", MFI.getBytesInStackArgArea()},
+        {"dynamic_stack", Frame.hasVarSizedObjects()},
+        {"private_access_instructions", PrivateAccesses},
+        {"opaque_inline_asm_instructions", OpaqueInlineAsms},
+        {"analyzed_vgpr_extent", ResourceUsage->NumVGPR},
+        {"analyzed_sgpr_extent", ResourceUsage->NumExplicitSGPR},
+        {"calls", std::move(Calls)}});
+  }
+}
+
+void AMDGPUAsmPrinter::emitAsmContractReport(Module &M) {
+  if (AsmContractReportPath.empty())
+    return;
+  std::error_code EC;
+  raw_fd_ostream OS(AsmContractReportPath, EC, sys::fs::OF_Text);
+  if (EC) {
+    M.getContext().diagnose(DiagnosticInfoGeneric(
+        "cannot write AMDGPU ASM contract report: " + EC.message(), DS_Error));
+    return;
+  }
+  OS << formatv("{0:2}\n",
+                json::Value(json::Object{
+                    {"schema", "amdgpu.asm_contract_report.v1"},
+                    {"scope", "compiled_module_and_declared_contracts"},
+                    {"strict_policy_status", StrictPolicyFailed ? "rejected"
+                                             : StrictFunctionPolicies.empty()
+                                                 ? "not_requested"
+                                                 : "checked"},
+                    {"external_object_audit_required", true},
+                    {"functions", std::move(AsmContractReports)}}));
+}
