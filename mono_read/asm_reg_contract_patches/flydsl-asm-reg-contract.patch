+def _run_llvm_ir_handoff(
+    module: ir.Module,
+    binary_fragment: str,
+    prefix: Path,
+    llvm_cli_args: list,
+    work_dir: Path,
+    stage_prefix: str,
+) -> None:
+    """Bundled MLIR emits linked, optimized LLVM bitcode; external llc + ld.lld build the binary.
+
+    LLVM IR crosses nearby LLVM versions far better than MLIR dialect syntax,
+    so the external LLVM need not match the bundled MLIR.
+    """
+    from .._mlir.dialects import gpu
+    from .._mlir.passmanager import PassManager
+
+    llc = _tool(prefix, "llc")
+    lld = _tool(prefix, "ld.lld")
+
+    fragment, n = re.subn(r"format=\w+", "format=llvm", binary_fragment)
+    if n != 1:
+        raise ExternalLLVMError(f"Cannot select LLVM IR output in binary pipeline fragment: {binary_fragment}")
+    pm = PassManager.parse(f"builtin.module({fragment})", context=module.context)
+    pm.run(module.operation)
+
+    binary = _single_top_level_op(module, "gpu.binary")
+    objects = ir.ArrayAttr(binary.attributes["objects"])
+    if len(objects) != 1:
+        raise ExternalLLVMError(f"Expected one gpu.object, found {len(objects)}.")
+    obj = gpu.ObjectAttr(objects[0])
+    target = str(obj.target)
+    chip = re.search(r'chip = "([^"]+)"', target)
+    if chip is None:
+        raise ExternalLLVMError(f"Cannot find the chip in target {target}")
+    features = re.search(r'features = "([^"]*)"', target)
+    opt_level = re.search(r"\bO = (\d)", target)
+
+    bitcode = work_dir / f"{stage_prefix}.bc"
+    isa = work_dir / f"{stage_prefix}.o"
+    hsaco = work_dir / f"{stage_prefix}.hsaco"
+    bitcode.write_bytes(obj.object)
+    llc_cmd = [
+        llc,
+        bitcode,
+        "-mtriple=amdgcn-amd-amdhsa",
+        f"-mcpu={chip.group(1)}",
+        f"-O{opt_level.group(1) if opt_level else 2}",
+        "-filetype=obj",
+        "-o",
+        isa,
+        *([f"-mattr={features.group(1)}"] if features and features.group(1) else []),
+        *llvm_cli_args,
+    ]
+    _run_tool(prefix, llc_cmd, work_dir)
+    _run_tool(prefix, [lld, "-shared", isa, "-o", hsaco], work_dir)
+
+    new_obj = gpu.ObjectAttr.get(
+        obj.target, int(gpu.CompilationTarget.Binary), hsaco.read_bytes(), obj.properties, None
+    )
+    binary.attributes["objects"] = ir.ArrayAttr.get([new_obj], context=module.context)
